---
import { useTranslations, getTranslation } from "../../utils/translations";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

import CartSummary from './CartSummary.jsx';
import CouponBox from './CouponBox.jsx';
import CheckoutForm from './CheckoutForm.jsx';
import PayPalPayment from './PayPalPayment.jsx';
import VisitorLookup from './VisitorLookup.jsx';
---
<section>
    <div class="bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-4xl font-extrabold text-center text-gray-900 uppercase">
        {locale === 'es' ? 'Finalizar Compra' : 'Checkout'}
      </h1>
    </div>
  </div>

  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {/* Columna principal */}
        <div class="lg:col-span-2 space-y-8">

          {/* 1. Verificar Visitante */}
          <section>
            <h2 class="text-2xl font-bold mb-4 text-gray-900">
              1. Verificar Registro
            </h2>
            <VisitorLookup client:load onVisitorFound={() => {}} />
          </section>

          {/* Cupón */}
          <!-- <section>
            <h2 class="text-2xl font-bold mb-4 text-gray-900">
              Código de Descuento
            </h2>
            <CouponBox client:load />
          </section> -->

          {/* 2. Checkout */}
          <section>
            <h2 class="text-2xl font-bold mb-4 text-gray-900">
              2. Resumen de Compra
            </h2>
            <CheckoutForm client:load onOrderCreated={() => {}} />
          </section>

          {/* 3. PayPal */}
          <section>
            <h2 class="text-2xl font-bold mb-4 text-gray-900">
              3. Procesar Pago
            </h2>
            <PayPalPayment client:load orderId={null} paypalOrderId={null} onSuccess={null} onError={null} />
          </section>
        </div>

        {/* Sidebar - Carrito */}
        <aside class="lg:col-span-1">
          <div class="sticky top-8">
            <h2 class="text-2xl font-bold mb-4 text-gray-900">
              Resumen
            </h2>
            <CartSummary client:load />
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>