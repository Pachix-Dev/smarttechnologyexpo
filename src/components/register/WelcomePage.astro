---
import { useTranslations, getTranslation } from "../../utils/translations";
import LogoGrid from "../shared/LogoGrid.astro";
import FreeAccessSection from "./FreeAccessSection.astro";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);

// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

import {
  sponsorsDiamond,
  sponsorsBronze,
  sponsorsPlatinum,
} from "../../logos.js";
import ConcurrentEventGrid from "./ConcurrentEventGrid.astro";

const base = locale === "en" ? "/en" : "";
---

<section class="w-full min-h-screen flex flex-col items-center justify-start">
  <header
    class="text-center bg-[url(/img/registerPage/hero_register_bg.png)] w-full h-auto sm:h-[200px] bg-cover bg-center flex flex-col sm:flex-row items-center justify-center text-2xl font-semibold text-white gap-x-36 gap-y-4 p-4"
  >
    <div>
      <a href={`${base}/`}>
        <img
          src="/img/smarttecexpo_logo.svg"
          alt="smart technology expo"
          loading="lazy"
          decoding="async"
          class="w-[150px] sm:w-[300px]"
        />
      </a>
    </div>
    <div>
      <h2
        class="text-2xl sm:text-5xl text-center sm:text-start font-montserrat-extra-bold-italic"
      >
        {locale === "es" ? "FORMA PARTE DE" : "BE PART OF"}
        <br />
        {locale === "es" ? "LA COMUNIDAD" : "THE COMMUNITY"}
      </h2>
    </div>
  </header>

  <!-- sección de acceso gratuito -->
  <FreeAccessSection />

  <!-- eventos concurrentes -->
  <ConcurrentEventGrid />

  <!-- patrocinadores -->
  <section class="py-4">
    <div class="w-full">
      <h2
        class="text-center text-xl sm:text-3xl font-montserrat-extra-bold-italic mt-8"
      >
        {locale === "es" ? "PATROCINADORES DIAMANTE" : "DIAMOND SPONSORS"}
      </h2>
      <!-- Se debe revisar dicho componente ya que no se respeta el tamaño de la image -->
      <!-- <LogoGrid logos={sponsorsDiamond} /> -->
      <div
        class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-1 lg:grid-cols-1 gap-2 sm:gap-8 place-items-center place-content-center max-w-4xl"
      >
        {
          sponsorsDiamond.map((partner, index) => (
            <div class="flex justify-center items-center">
              <img
                src={partner.src}
                alt={partner.alt}
                class="w-[200px] sm:w-[300px] object-contain"
              />
            </div>
          ))
        }
      </div>
    </div>
    <div class="w-full">
      <h2
        class="text-center text-xl sm:text-3xl font-montserrat-extra-bold-italic mt-8"
      >
        {locale === "es" ? "PATROCINADORES PLATINUM" : "DIAMOND SPONSORS"}
      </h2>
      <!-- <LogoGrid logos={sponsorsPlatinum} /> -->
      <div class="flex justify-center w-full">
        <div
          class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-1 lg:grid-cols-1 gap-2 sm:gap-8 place-items-center place-content-center max-w-4xl"
        >
          {
            sponsorsPlatinum.map((partner, index) => (
              <div class="flex justify-center items-center">
                <img
                  src={partner.src}
                  alt={partner.alt}
                  class="w-[170px] sm:w-[240px] object-contain"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</section>
