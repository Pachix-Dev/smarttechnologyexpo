---
const { locale = "es" } = Astro.props;

const basePath = locale === "en" ? "/en" : "";

const registrationNotice =
  locale === "en"
    ? {
        question: "Other registrations",
        studentButton: "STUDENT",
        mediaButton: "MEDIA",
        generalRegistration: "GENERAL REGISTRATION",
        studentTitle: "Important",
        studentParagraphs: [
          "This event is intended exclusively for industry professionals, executives, decision-makers, technical specialists, and company representatives.",
          "Due to the specialized nature of the program and networking activities, registration is not available for students.",
          "We appreciate your understanding and kindly ask you to avoid submitting registrations that do not meet this criterion, as access to the venue cannot be authorized.",
        ],
      }
    : {
        question: "Otros registros",
        studentButton: "ESTUDIANTE",
        mediaButton: "MEDIO",
        generalRegistration: "REGISTRO GENERAL",
        studentTitle: "Importante",
        studentParagraphs: [
          "Este evento está dirigido exclusivamente a profesionales de la industria, ejecutivos, tomadores de decisión, especialistas técnicos y representantes de empresas.",
          "Por la naturaleza especializada del programa y de las actividades de networking, el registro no está disponible para estudiantes.",
          "Agradecemos su comprensión y les solicitamos amablemente evitar realizar registros que no cumplan con este criterio, ya que no será posible autorizar el acceso al recinto.",
        ],
      };
---

<section
  class="mx-auto mb-6 rounded-lg border border-slate-200 bg-white p-4 text-left shadow-sm"
  aria-labelledby="registration-notice-title"
>
  <div class="flex flex-col items-start gap-3">
    <div class="flex items-center gap-2">
      <h3
        id="registration-notice-title"
        class="text-sm font-extrabold uppercase tracking-wide text-slate-900 sm:text-base"
      >
        {registrationNotice.question}
      </h3>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 15 15"
        ><path
          fill="currentColor"
          d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"
        ></path></svg
      >
    </div>

    <div class="w-full space-y-3">
      <div class="grid gap-3 sm:grid-cols-3">

        <!-- General registration section -->
        <a
          id="registro-general"
          href="#register-form"
          class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-left text-xs font-extrabold uppercase tracking-wide text-green-900 transition hover:bg-green-200 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 flex flex-row items-center justify-between"
        >
          {registrationNotice.generalRegistration}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="m13.172 12l-4.95-4.95l1.414-1.413L16 12l-6.364 6.364l-1.414-1.415z"
            ></path></svg
          >
        </a>

        <!-- Media registration section -->
        <a
          href={`${basePath}/medios`}
          class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-left text-xs font-extrabold uppercase tracking-wide text-blue-900 transition hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 flex flex-row items-center justify-between"
        >
          {registrationNotice.mediaButton}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            ><path
              fill="currentColor"
              d="m13.172 12l-4.95-4.95l1.414-1.413L16 12l-6.364 6.364l-1.414-1.415z"
            ></path></svg
          >
        </a>

        <!-- Student registration section -->
        <details class="group contents">

          <summary
            class="w-full rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-left text-xs font-extrabold uppercase tracking-wide text-orange-900 transition hover:bg-orange-100 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 flex cursor-pointer list-none flex-row items-center justify-between [&::-webkit-details-marker]:hidden"
          >
            {registrationNotice.studentButton}
            <svg
              class="transition-transform group-open:rotate-90"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="m13.172 12l-4.95-4.95l1.414-1.413L16 12l-6.364 6.364l-1.414-1.415z"
              ></path></svg
            >
          </summary>

          <div class="col-span-full w-full rounded-lg border border-orange-200 border-l-4 border-l-orange-500 bg-orange-50 p-3">
            <div class="flex flex-row gap-x-2 justify-start items-center">
              <svg
                class="mb-2 size-5 text-orange-900"
                aria-hidden="true"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.515 2.625H3.72c-1.345 0-2.188-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
                  clip-rule="evenodd"></path>
              </svg>
              <h4
                class="mb-2 text-sm font-extrabold uppercase tracking-wide text-orange-900"
              >
                {registrationNotice.studentTitle}
              </h4>
            </div>
            <div class="space-y-0">
              {
                registrationNotice.studentParagraphs.map((paragraph) => (
                  <p class="text-xs leading-relaxed text-orange-950">
                    {paragraph}
                  </p>
                ))
              }
            </div>
          </div>

        </details>

        
      </div>
    </div>
  </div>
</section>
