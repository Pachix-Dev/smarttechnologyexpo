---
import { useTranslations, getTranslation } from "../../utils/translations";

const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const isEnglish = locale === "en";
---

<section
  class="relative isolate flex min-h-[560px] items-center overflow-hidden bg-[linear-gradient(90deg,rgba(3,7,18,0.92),rgba(12,26,45,0.82),rgba(15,23,42,0.52)),url('/img/bg_smart_desc_2.png')] bg-cover bg-center px-4 py-16 text-white sm:min-h-[620px] sm:py-20 lg:min-h-[680px] lg:py-24"
  aria-labelledby="csia-hero-title"
>
  <div
    class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-slate-950/90 to-transparent"
  >
  </div>

  <div class="relative mx-auto w-full max-w-7xl">
    <div class="mx-auto max-w-5xl text-center lg:mx-0 lg:text-left">
      <h1
        id="csia-hero-title"
        class="m-0 max-w-5xl text-[clamp(2rem,5vw,4rem)] font-black uppercase leading-[1.02] tracking-normal text-white [text-wrap:balance]"
        data-aos="fade-down"
      >
        <span
          class="block text-[clamp(1.05rem,2.3vw,1.65rem)] font-bold leading-tight text-slate-100"
        >
          {
            locale === "en"
              ? "Technical Workshops of the"
              : "Talleres Tecnicos de la"
          }
        </span>
        <span
          class="mt-2 block text-[#E7000B] drop-shadow-[0_8px_24px_rgba(0,0,0,0.45)]"
        >
          Control System Integrators Association
        </span>
        <span
          class="mt-2 block text-[clamp(1.35rem,3.5vw,2.8rem)] text-sky-100"
        >
          (CSIA)
        </span>
      </h1>
      <p
        class="mx-auto mt-6 max-w-3xl text-base font-medium leading-relaxed text-slate-200 [text-wrap:pretty] sm:text-lg lg:mx-0 lg:text-xl"
        data-aos="fade-down"
        data-aos-delay="300"
      >
        {
          tr(
            "csia.hero.description",
            isEnglish
              ? "Reserve your seat in specialized sessions designed for professionals who want practical knowledge in automation, robotics and industrial system integration."
              : "Reserva tu lugar en sesiones especializadas para profesionales que buscan conocimiento practico en automatizacion, robotica e integracion de sistemas industriales.",
          )
        }
      </p>
      <div class="mt-10 max-w-2xl">
        <p
          class="mb-3 text-xs font-black uppercase leading-tight tracking-[0.14em] text-slate-300"
          data-aos="fade-zoom-in"
          data-aos-easing="ease-in-back"
          data-aos-delay="300"
          data-aos-offset="0"
        >
          {isEnglish ? "Organized by" : "Organizado por"}
        </p>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-2">
          <div
            class="flex min-h-28 items-center justify-center px-5 py-4"
            data-aos="fade-zoom-in"
            data-aos-easing="ease-in-back"
            data-aos-delay="400"
            data-aos-offset="0"
          >
            <img
              class="h-auto max-h-16 w-full max-w-56 object-contain"
              src="/img/smarttecexpo_logo.svg"
              alt="Smart Technology Expo"
              loading="eager"
            />
          </div>
          <div
            class="flex min-h-28 items-center justify-center px-5 py-4"
            data-aos="fade-zoom-in"
            data-aos-easing="ease-in-back"
            data-aos-delay="500"
            data-aos-offset="0"
          >
            <img
              class="h-auto max-h-16 w-full max-w-56 object-contain"
              src="/img/logos/strategic_partners/csia_bn.webp"
              alt="CSIA"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
