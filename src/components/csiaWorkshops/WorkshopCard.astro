---
import { useTranslations, getTranslation } from "../../utils/translations";
import { csiaWorkshops2026 } from "../../data/csia_workshops_2026.js";

const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const isEnglish = locale === "en";

const formatDate = (date: string) => {
  const parsedDate = new Date(`${date}T12:00:00`);

  return new Intl.DateTimeFormat(isEnglish ? "en-US" : "es-MX", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  }).format(parsedDate);
};
---
<section
  class="overflow-hidden bg-[linear-gradient(135deg,rgba(5,12,22,0.98),rgba(11,34,58,0.95))] px-4 py-14 text-white sm:py-16 lg:py-24"
  aria-labelledby="csia-workshops-title"
>
  <div class="mx-auto w-full max-w-[1180px]">
    <div
      class="mb-8 grid gap-5 md:mb-12 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.6fr)] md:items-end"
    >
      <p
        class="border-l-4 border-red-600 pl-4 text-xs sm:text-base font-extrabold uppercase leading-tight tracking-[0.12em] text-white"
      >
        {locale === "en" ? "Commercial Program" : "Programa comercial"}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-2 max-w-4xl mx-auto">
      {
        csiaWorkshops2026.map((workshop) => {
          const title = isEnglish ? workshop.title_en : workshop.title_es;
          const description = isEnglish
            ? workshop.description_en
            : workshop.description_es;

          return (
            <article class="relative flex min-h-full flex-col overflow-hidden rounded-lg border border-slate-400/45 bg-white text-slate-900 shadow-[0_22px_45px_rgba(0,0,0,0.28)] before:absolute before:inset-x-0 before:top-0 before:h-1.5 before:bg-gradient-to-r before:from-red-600 before:from-[34%] before:via-[#4d6f8d] before:to-[#93a9bd] before:content-['']">
              <div class="flex flex-1 flex-col px-5 pb-5 pt-7">
                <h3 class="m-0 rounded-lg border-l-[5px] border-red-600 bg-gradient-to-br from-slate-950 via-sky-950 to-slate-500 p-4 text-[clamp(1.2rem,2.1vw,1.55rem)] font-black uppercase leading-[1.12] tracking-normal text-white">
                  {title}
                </h3>
                <p class="mb-5 mt-3.5 text-[0.95rem] leading-relaxed text-slate-700">
                  {description}
                </p>

                <dl class="mt-auto grid grid-cols-2 gap-3 sm:grid-cols-2">
                  <div class="min-w-0 rounded-lg border border-slate-200 bg-slate-100 p-3">
                    <dt class="mb-1 text-[0.67rem] font-black uppercase leading-tight tracking-[0.08em] text-red-700">
                      {locale === "en" ? "Date" : "Fecha"}
                    </dt>
                    <dd class="m-0 break-words text-sm font-bold leading-snug text-slate-900">
                      {formatDate(workshop.date)}
                    </dd>
                  </div>
                  <div class="min-w-0 rounded-lg border border-slate-200 bg-slate-100 p-3">
                    <dt class="mb-1 text-[0.67rem] font-black uppercase leading-tight tracking-[0.08em] text-red-700">
                      {locale === "en" ? "Schedule" : "Horario"}
                    </dt>
                    <dd class="m-0 break-words text-sm font-bold leading-snug text-slate-900">
                      {workshop.time}
                    </dd>
                  </div>
                  <div class="min-w-0 rounded-lg border border-slate-200 bg-slate-100 p-3">
                    <dt class="mb-1 text-[0.67rem] font-black uppercase leading-tight tracking-[0.08em] text-red-700">
                      {locale === "en" ? "Duration" : "Duración"}
                    </dt>
                    <dd class="m-0 break-words text-sm font-bold leading-snug text-slate-900">
                      {workshop.duration}
                    </dd>
                  </div>
                  <div class="min-w-0 rounded-lg border border-slate-200 bg-slate-100 p-3">
                    <dt class="mb-1 text-[0.67rem] font-black uppercase leading-tight tracking-[0.08em] text-red-700">
                      {locale === "en" ? "Room" : "Sala"}
                    </dt>
                    <dd class="m-0 break-words text-sm font-bold leading-snug text-slate-900">
                      {workshop.location}
                    </dd>
                  </div>
                </dl>
                <p class="col-span-full mt-3 rounded-lg border border-sky-300/50 bg-gradient-to-r from-slate-950 via-sky-900 to-slate-700 px-3 py-2 text-center text-xs font-extrabold uppercase tracking-[0.08em] text-sky-50 shadow-sm shadow-sky-950/20">
                  {locale === "en"  ? "Participant limit : " : "Limite de participantes : "} {workshop.limit}
                </p>
              </div>

              <div class="grid grid-cols-2 gap-3 bg-slate-950 px-5 pb-5 pt-4 min-[421px]:grid-cols-2">
                <div class="min-w-0">
                  <span class="block text-[0.7rem] font-extrabold uppercase leading-tight tracking-[0.08em] text-amber-400">
                    {locale === "en" ? "Early Bird Rate" : "Preventa"}
                  </span>
                  <strong class="mt-1 block text-[clamp(1.4rem,3vw,1.9rem)] font-black leading-none text-amber-400">
                    {workshop.early_bird_rate}
                  </strong>
                  <span class="mt-1 block text-xs font-bold uppercase leading-tight tracking-[0.08em] text-slate-100">
                    {locale === "en" ? "+ VAT" : "+ IVA"}
                  </span>
                </div>
                <div class="min-w-0 min-[421px]:pt-0">
                  <span class="block text-[0.7rem] font-extrabold uppercase leading-tight tracking-[0.08em] text-slate-400">
                    {locale === "en" ? "Regular Rate" : "Tarifa regular"}
                  </span>
                  <strong class="mt-1 block text-[clamp(1.1rem,2.4vw,1.35rem)] font-black leading-none text-slate-300">
                    {workshop.regular_rate}
                  </strong>
                  <span class="mt-1 block text-xs font-bold uppercase leading-tight tracking-[0.08em] text-slate-400">
                    {locale === "en" ? "+ VAT" : "+ IVA"}
                  </span>
                </div>
                <p class="text-amber-400 col-span-full rounded-lg border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-center text-xs font-semibold uppercase tracking-[0.08em]">
                  {locale === "en"
                    ? "Early bird valid until August 31"
                    : "Preventa valida hasta el 31 de agosto"}
                </p>
                <a
                  class="col-span-full inline-flex min-h-[46px] w-full items-center justify-center rounded-lg bg-green-600 px-4 py-3 text-center text-sm font-black leading-tight text-white no-underline transition duration-200 hover:-translate-y-px hover:bg-blue-700 focus-visible:-translate-y-px focus-visible:bg-blue-700 focus-visible:outline-offset-[3px] focus-visible:outline-slate-300 uppercase between-items-center gap-2"
                  href="/productos"
                >
                  {locale === "en" ? "Buy Workshop" : "Comprar taller"}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 15 15"><path fill="currentColor" d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"/></svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
