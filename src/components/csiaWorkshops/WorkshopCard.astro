---
import { useTranslations, getTranslation } from "../../utils/translations";

const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const isEnglish = locale === "en";

const content = {
  intro: isEnglish
    ? "This two-day executive program is designed to provide system integration companies with the tools, methodologies and strategies they need to strengthen management, increase profitability and build a more competitive, future-ready organization."
    : "Este programa ejecutivo de dos días está diseñado para brindar a las empresas integradoras de sistemas las herramientas, metodologías y estrategias que les permitirán fortalecer su gestión, incrementar su rentabilidad y desarrollar una organización más competitiva y preparada para el futuro.",
  basedOn: isEnglish
    ? "Based on the internationally recognized CSIA Best Practices, the program combines practical knowledge, real-world experience and proven methodologies to help companies improve performance across every area of the business."
    : "Basado en las Mejores Prácticas de la CSIA, reconocidas internacionalmente, el programa combina conocimientos prácticos, experiencias reales y metodologías comprobadas para ayudar a las empresas a mejorar su desempeño en todas las áreas del negocio.",
  learnTitle: isEnglish ? "During the program you will learn to:" : "Durante el programa aprenderá a:",
  learnItems: isEnglish
    ? [
        "Implement CSIA Best Practices in your organization.",
        "Strengthen strategic direction and business leadership.",
        "Optimize project management and operations.",
        "Improve commercial, financial and customer service processes.",
        "Reduce risk and increase business profitability.",
        "Understand the path to CSIA Certification and its benefits for your company.",
      ]
    : [
        "Implementar las Mejores Prácticas de la CSIA en su organización.",
        "Fortalecer la dirección estratégica y el liderazgo empresarial.",
        "Optimizar la gestión de proyectos y las operaciones.",
        "Mejorar los procesos comerciales, financieros y de servicio al cliente.",
        "Reducir riesgos e incrementar la rentabilidad del negocio.",
        "Conocer el camino hacia la Certificación CSIA y los beneficios que representa para su empresa.",
      ],
  audienceTitle: isEnglish ? "Who should attend" : "Dirigido a",
  audienceItems: isEnglish
    ? [
        "CEOs and general managers",
        "Owners of system integration companies",
        "Operations managers",
        "Project managers",
        "Technical and commercial leaders",
      ]
    : [
        "Directores generales",
        "Propietarios de empresas integradoras",
        "Gerentes de operaciones",
        "Gerentes de proyectos",
        "Líderes técnicos y comerciales",
      ],
  detailsTitle: isEnglish ? "Program details" : "Detalles del programa",
  details: [
    {
      label: isEnglish ? "Dates" : "Fechas",
      value: isEnglish ? "November 19 and 20, 2026" : "19 y 20 de noviembre de 2026",
    },
    {
      label: isEnglish ? "Schedule" : "Horario",
      value: "9:00 am - 5:00 pm",
    },
    {
      label: isEnglish ? "Venue" : "Sede",
      value: isEnglish
        ? "During Smart Technology Expo, inside Expo Guadalajara"
        : "Durante Smart Technology Expo, dentro de Expo Guadalajara",
    },
    {
      label: isEnglish ? "Presented by" : "Imparte",
      value: "Control System Integrators Association (CSIA)",
    },
  ],
  priceTitle: isEnglish ? "Investment" : "Inversión",
  earlyPrice: isEnglish
    ? "Early bird rate: August and September"
    : "Preventa: Agosto y septiembre",
  regularPrice: isEnglish
    ? "Regular rate: October or until sold out"
    : "Tarifa normal: Octubre y/o hasta agotar existencias",
  limit: isEnglish ? "CAPACITY LIMITED" : "CUPO LIMITADO",
  closing: isEnglish
    ? "Transform your company. Adopt CSIA Best Practices and take your organization to the next level."
    : "Transforme su empresa. Adopte las Mejores Prácticas de la CSIA y lleve su organización al siguiente nivel.",
  cta: isEnglish ? "Buy workshop" : "Comprar taller",
};
---

<section
  class="bg-slate-950 px-4 py-14 text-white sm:py-16 lg:py-24"
  aria-labelledby="csia-workshops-title"
>
  <div class="mx-auto w-full max-w-7xl">
    <div
      class="grid gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(320px,0.65fr)] lg:items-start"
    >
      <article
        class="rounded-lg border border-white/10 bg-white px-5 py-6 text-slate-950 shadow-2xl shadow-black/25 sm:px-7 sm:py-8 lg:px-9"
        data-aos="fade-up"
      >
        <h2 id="csia-workshops-title" class="sr-only">
          {isEnglish ? "CSIA Executive Program" : "Programa ejecutivo CSIA"}
        </h2>

        <div class="grid gap-4 text-base leading-relaxed text-slate-700 sm:text-lg">
          <p>{content.intro}</p>
          <p>
            {isEnglish ? "Based on the " : "Basado en las "}
            <strong class="font-black text-slate-950">
              {isEnglish ? "CSIA Best Practices" : "Mejores Prácticas de la CSIA"}
            </strong>
            {isEnglish
              ? ", internationally recognized, the program combines practical knowledge, real-world experience and proven methodologies to help companies improve performance across every area of the business."
              : ", reconocidas internacionalmente, el programa combina conocimientos prácticos, experiencias reales y metodologías comprobadas para ayudar a las empresas a mejorar su desempeño en todas las áreas del negocio."}
          </p>
        </div>

        <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1.2fr)_minmax(260px,0.8fr)]">
          <section class="rounded-lg border border-slate-200 bg-slate-50 p-5">
            <h3 class="m-0 text-lg font-black uppercase tracking-normal text-slate-950">
              {content.learnTitle}
            </h3>
            <ul class="mt-4 grid gap-3">
              {
                content.learnItems.map((item) => (
                  <li class="flex gap-3 text-sm font-semibold leading-relaxed text-slate-700 sm:text-base">
                    <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-red-600"></span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="rounded-lg border border-slate-200 bg-slate-50 p-5">
            <h3 class="m-0 text-lg font-black uppercase tracking-normal text-slate-950">
              {content.audienceTitle}
            </h3>
            <ul class="mt-4 grid gap-2">
              {
                content.audienceItems.map((item) => (
                  <li class="rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-slate-700">
                    {item}
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <p class="mt-8 rounded-lg bg-gradient-to-r from-slate-950 via-sky-950 to-slate-700 px-5 py-4 text-base font-black uppercase leading-relaxed text-white [text-wrap:balance] sm:text-lg">
          {content.closing}
        </p>
      </article>

      <aside
        class="grid gap-4 rounded-lg border border-white/10 bg-white/5 p-4 backdrop-blur"
        data-aos="fade-up"
        data-aos-delay="150"
      >
        <section class="rounded-lg bg-white p-5 text-slate-950">
          <h3 class="m-0 text-lg font-black uppercase text-slate-950">
            {content.detailsTitle}
          </h3>
          <dl class="mt-4 grid gap-3">
            {
              content.details.map((detail) => (
                <div class="rounded-md border border-slate-200 bg-slate-50 p-3">
                  <dt class="text-[0.7rem] font-black uppercase tracking-[0.1em] text-red-700">
                    {detail.label}
                  </dt>
                  <dd class="mt-1 m-0 text-sm font-semibold leading-snug text-slate-900">
                    {detail.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="rounded-lg bg-slate-950 p-5 text-white ring-1 ring-white/10">
          <h3 class="m-0 text-lg font-black uppercase">
            {content.priceTitle}
          </h3>

          <div class="mt-4 grid gap-3">
            <div class="rounded-lg border border-amber-400/40 bg-amber-400/10 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-amber-300">
                {content.earlyPrice}
              </p>
              <p class="mt-1 text-3xl font-black text-white">$5,000 MXN <span class="text-base font-black uppercase tracking-[0.1em] text-slate-300">{locale === "es" ? "+ IVA" : "+ VAT"}</span></p>
            </div>

            <div class="rounded-lg border border-slate-500/50 bg-white/5 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.1em] text-slate-300">
                {content.regularPrice}
              </p>
              <p class="mt-1 text-3xl font-black text-white">$6,000 MXN <span class="text-base font-black uppercase tracking-[0.1em] text-slate-300">{locale === "es" ? "+ IVA" : "+ VAT"}</span></p>
            </div>
          </div>

          <p class="mt-4 rounded-lg border border-red-400/60 bg-red-600 px-3 py-2 text-center text-xs font-semibold uppercase tracking-[0.1em] text-white shadow-lg shadow-red-950/30">
            {content.limit}
          </p>

          <a
            class="mt-4 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-green-600 px-5 py-3 text-center text-sm font-black uppercase tracking-[0.08em] text-white no-underline transition duration-200 hover:-translate-y-px hover:bg-blue-700 focus-visible:-translate-y-px focus-visible:bg-blue-700 focus-visible:outline-white"
            href="/productos"
          >
            {content.cta}
            <svg
              aria-hidden="true"
              class="h-4 w-4 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 15 15"
            >
              <path
                fill="currentColor"
                d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"
              />
            </svg>
          </a>
        </section>
      </aside>
    </div>
  </div>
</section>
