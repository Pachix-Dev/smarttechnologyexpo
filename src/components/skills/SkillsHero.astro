---
// ============================================================================
//  COMPONENTE SKILLS HERO — Escenario SMART SKILLS (Talleres)
//  Autor: Donovan Oswaldo Villalba Hernandez
//
//  Cabecera (header/switcher) + hero de la página interior de SMART SKILLS.
//  Es la portada del escenario de talleres: eyebrow, título en 2 líneas,
//  descripción y un aviso destacado (cupo limitado / registro previo).
//
//  Estructura visual (de fondo a frente):
//    - HeaderSwitcher compartido (marca activa: "talleres").
//    - Fondo rojo sólido (.sh-fill) con textura de puntos oscuros (.sh-dots).
//    - Contenido: eyebrow con línea, título Smart/Skills, descripción y aviso.
//
//  Estilos: este componente usa sus propias clases sh-* en el <style> scoped de
//  abajo; NO dependen de skills.css (que agrupa ssc-/sw-/wf-).
//
//  Props: todo es configurable desde fuera (eyebrow, title1/2, description,
//         notice, logoSrc); si no se pasa, se usan los valores por defecto.
//
//  i18n: los textos por defecto salen de los locales vía tr('clave', 'fallback').
//        Si la clave no existe en el idioma actual, se usa el texto de respaldo.
// ============================================================================
import HeaderSwitcher from '../shared/HeaderSwitcher.astro';
import { useTranslations, getTranslation } from "../../utils/translations";

// Props del componente: todas opcionales (tienen default más abajo).
export interface Props {
  eyebrow?: string;
  title1?: string;
  title2?: string;
  description?: string;
  notice?: string;
  logoSrc?: string;
}

// useTranslations resuelve el idioma activo y devuelve el diccionario (translations).
const { translations, locale } = await useTranslations(Astro.props, Astro);
// tr(): lee una clave del diccionario; el 2º argumento es el fallback si no existe.
const tr = (key: string, fallback: string = "") => getTranslation(translations, key, fallback);

// Props con valores por defecto (traducidos). Si quien usa el componente pasa
// una prop, esa gana; si no, se usa el fallback en el idioma actual.
const {
  eyebrow = tr('skills.hero.eyebrow', 'TALLERES PRÁCTICOS'),
  title1 = 'Smart',
  title2 = 'Skills',
  description = tr('skills.hero.description', 'Aprendizaje práctico y aplicación real de la tecnología. Capacitaciones para desarrollar habilidades técnicas, conocer herramientas clave y profundizar en soluciones aplicables a entornos productivos.'),
  notice = tr('skills.hero.notice', 'TALLERES GRATUITOS · CUPO LIMITADO · REGISTRO PREVIO REQUERIDO'),
  logoSrc,
} = Astro.props;
---

<!-- Cabecera compartida con selector de escenario (marca "talleres" activa) -->
<HeaderSwitcher active="talleres"/>

<!-- ── HERO ─────────────────────────────────────────────────────────── -->
<section class="sh-hero">
  <!-- Capas de fondo: relleno rojo + textura de puntos (aria-hidden) -->
  <div class="sh-fill" aria-hidden="true"></div>
  <div class="sh-dots" aria-hidden="true"></div>

  <div class="sh-inner">
    <!-- Eyebrow: línea negra + texto pequeño en mayúsculas -->
    <div class="sh-eyebrow">
      <span class="sh-eyebrow-line"></span>
      <span class="sh-eyebrow-text">{eyebrow}</span>
    </div>

    <!-- Título en 2 líneas: "Smart" arriba, "Skills" abajo -->
    <h1 class="sh-title">
      <span class="sh-title-a">{title1}</span><br />
      <span class="sh-title-b">{title2}</span>
    </h1>

    <p class="sh-description">{description}</p>

    <!-- Aviso destacado: punto + texto (cupo/registro) -->
    <div class="sh-notice">
      <span class="sh-notice-dot"></span>
      <span class="sh-notice-text">{notice}</span>
    </div>
  </div>
</section>

<style>
  /* ── HERO: contenedor ─────────────────────────────────────────────── */
  .sh-hero {
    position: relative;
    background: #000;
    overflow: hidden;
    border-bottom: 1px solid #161616;
    font-family: 'Archivo', Helvetica, Arial, sans-serif;
    color: #fff;
  }

  /* Relleno rojo sólido que da la identidad del escenario Skills. */
  .sh-fill {
    position: absolute;
    inset: 0;
    background: #e2101a;
  }

  /* Textura de puntos oscuros sobre el rojo. */
  .sh-dots {
    position: absolute;
    inset: 0;
    background-image: repeating-radial-gradient(circle at 78% 42%, rgba(0, 0, 0, 0.14) 0 1px, transparent 1px 26px);
  }

  /* ── CONTENEDOR INTERNO ───────────────────────────────────────────── */
  .sh-inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(48px, 9vw, 104px) clamp(16px, 4vw, 40px) clamp(40px, 7vw, 80px);
  }

  /* ── EYEBROW (línea + texto) ──────────────────────────────────────── */
  .sh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .sh-eyebrow-line {
    width: 30px;
    height: 2px;
    background: #000;
  }

  .sh-eyebrow-text {
    font-size: 12px;
    letter-spacing: 0.3em;
    font-weight: 700;
    color: #fff;
  }

  /* ── TÍTULO ───────────────────────────────────────────────────────── */
  .sh-title {
    margin: 0;
    font-size: clamp(52px, 11vw, 128px);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* Ambas líneas del título llevan el mismo glow blanco en capas. */
  .sh-title-a {
    color: #fff;
    text-shadow:
      0 0 2px  #fff,
      0 0 6px  #fff,
      0 0 12px rgba(255, 255, 255, 0.55),
      0 0 24px rgba(255, 255, 255, 0.35),
      0 0 48px rgba(255, 255, 255, 0.2);
  }

  .sh-title-b {
    color: #fff;
    text-shadow:
      0 0 2px  #fff,
      0 0 6px  #fff,
      0 0 12px rgba(255, 255, 255, 0.55),
      0 0 24px rgba(255, 255, 255, 0.35),
      0 0 48px rgba(255, 255, 255, 0.2);
  }

  /* ── DESCRIPCIÓN ──────────────────────────────────────────────────── */
  .sh-description {
    margin: 26px 0 0;
    max-width: 640px;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
    text-wrap: pretty;
  }

  /* ── AVISO (cupo / registro) ──────────────────────────────────────── */
  .sh-notice {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    padding: 12px 18px;
    background: rgba(0, 0, 0, 0.28);
    border: 1px solid rgba(0, 0, 0, 0.4);
    border-radius: 5px;
  }

  .sh-notice-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #000;
  }

  .sh-notice-text {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fff;
  }
</style>