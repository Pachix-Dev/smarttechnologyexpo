---
// SkillsWorkshops.astro — Wrapper delgado del catálogo "Talleres disponibles".
// La lógica interactiva (barra de cupo en vivo, botón Inscribirme) vive AHORA en la
// isla React SkillsWorkshopsLive.jsx — ya no hay <script> embebido en el .astro.
// Este archivo solo: 1) arma la lista de talleres localizada (desde data/workshops.js),
// 2) arma los textos con tr(), y 3) monta la isla pasándole todo por props.
import SkillsWorkshopsLive from './SkillsWorkshopsLive.jsx';
import './skillsWorkshops.css';
import { useTranslations, getTranslation } from "../../utils/translations";
import { workshops as workshopsData } from "../../data/workshops.js";

export interface Props {
  accent?: string;
}

const { translations, locale } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") => getTranslation(translations, key, fallback);

const { accent = '#E2101A' } = Astro.props;

// Lista de talleres ya localizada (info estática desde data/workshops.js).
// El cupo NO se pone aquí: lo trae la isla en vivo desde /workshops.
const workshops = workshopsData.map((w) => ({
  workshopId: w.workshopId,
  name: locale === 'en' ? w.name_en : w.name,
  nivel: w.nivel,
  instructor: w.instructor,
  instructorRole: locale === 'en' ? w.instructorRole_en : w.instructorRole,
  instructorBio: locale === 'en' ? w.instructorBio_en : w.instructorBio,
  duracion: locale === 'en' ? w.duracion_en : w.duracion,
  horario: w.horario,
  sala: w.sala,
  cupo: w.cupo,                 // cupo inicial (se sustituye por el real de la BD)
  requisitos: locale === 'en' ? w.requisitos_en : w.requisitos,
}));

// Todos los textos de interfaz, ya traducidos, para la isla.
const labels = {
  eyebrow: tr('skills.workshops.eyebrow', 'CATÁLOGO'),
  title: tr('skills.workshops.title', 'Talleres disponibles'),
  note: tr('skills.workshops.note', 'Cada taller incluye instructor especializado, duración y requisitos. Inscríbete desde el formulario al final.'),
  schedule: tr('skills.workshops.schedule', 'HORARIO'),
  room: tr('skills.workshops.room', 'SALA'),
  reqs: tr('skills.workshops.reqs', 'REQUISITOS'),
  capacity: tr('skills.workshops.capacity', 'Cupo'),
  enroll: tr('skills.workshops.enroll', 'Inscribirme'),
  bioBtn: tr('skills.workshops.bio_btn', 'VER SEMBLANZA'),
  nivelBasic: tr('skills.workshops.nivel_basic', 'BÁSICO'),
  nivelIntermediate: tr('skills.workshops.nivel_intermediate', 'INTERMEDIO'),
  nivelAdvanced: tr('skills.workshops.nivel_advanced', 'AVANZADO'),
  seatsAvailable: tr('skills.workshops.seats_available', 'lugares disponibles'),
  seatsLast: tr('skills.workshops.seats_last', '¡Últimos {n} lugares!'),
  soldOut: tr('skills.workshops.sold_out', 'Cupo lleno'),
  instructorOrg: tr('skills.workshops.instructor_org', 'Smart Technology Expo · Instructor'),
};
---

<SkillsWorkshopsLive
  client:load
  workshops={workshops}
  labels={labels}
  accent={accent}
/>