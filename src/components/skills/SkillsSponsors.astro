---
// ============================================================================
//  COMPONENTE SKILLS SPONSORS — Patrocinadores del escenario SMART SKILLS
//  Autor: Donovan Oswaldo Villalba Hernandez
//
//  Vitrina de patrocinadores del escenario de talleres. Toma los logos de la
//  constante `skillsSponsors` (archivo de logos) y los muestra como una fila
//  centrada de tarjetas blancas clickeables (cada logo enlaza a su sitio).
//
//  Estructura visual:
//    - Fondo negro con el mismo look del escenario (fuente Archivo).
//    - Encabezado centrado: eyebrow + título.
//    - Fila de logos (.sp-grid): cada logo va en una tarjeta blanca (.sp-card),
//      envuelta en un <a> que enlaza a su sitio.
//
//  Datos: cada objeto de `skillsSponsors` tiene { src, alt, href?, width }.
//  i18n: los textos salen de los locales vía tr('clave', 'fallback').
// ============================================================================
import { skillsSponsors } from '../../logos.js';
import { useTranslations, getTranslation } from '../../utils/translations';

const { translations, locale } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = '') => getTranslation(translations, key, fallback);
---

<!-- ── SECCIÓN PATROCINADORES ───────────────────────────────────────── -->
<section class="sp-section">
  <div class="sp-inner" data-aos="fade-up" data-aos-duration="800">
    <!-- Encabezado: título -->
    <h1 class="sp-title">{tr('skills.sponsors.title', 'Patrocinadores')}</h1>

    <!-- Fila de logos: se genera recorriendo la constante skillsSponsors -->
    <div class="sp-grid">
      {skillsSponsors.map((s) => (
        <a class="sp-card" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.alt}>
          <img class="sp-logo" src={s.src} alt={s.alt} style={`max-width:${s.width}px`} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── SECCIÓN: contenedor de fondo ─────────────────────────────────── */
  .sp-section {
    width: 100%;
    background: #000;
    font-family: 'Archivo', Helvetica, Arial, sans-serif;
    color: #fff;
  }

  /* ── CONTENEDOR INTERNO ───────────────────────────────────────────── */
  .sp-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(56px, 8vw, 96px) clamp(16px, 4vw, 40px);
    text-align: center;
  }

  /* ── ENCABEZADO ───────────────────────────────────────────────────── */
  .sp-eyebrow {
    font-size: 12px;
    letter-spacing: 0.3em;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }

  .sp-title {
    margin: 0 0 40px;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 0.95;
  }

  /* ── REJILLA DE LOGOS ─────────────────────────────────────────────── */
  /* Fila centrada; se envuelve en pantallas chicas. */
  .sp-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 4vw, 48px);
  }

  /* Tarjeta blanca del logo (clickeable). */
  .sp-card {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 24px 32px;
    background: #fff;
    border-radius: 12px;
    min-width: 220px;
    min-height: 130px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sp-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.35);
  }

  /* Logo: se acopla a la tarjeta sin deformarse. */
  .sp-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  /* ── MÓVIL ────────────────────────────────────────────────────────── */
  @media (max-width: 560px) {
    .sp-card {
      min-width: 0;
      width: 100%;
      max-width: 320px;
      padding: 20px 24px;
    }
  }
</style>