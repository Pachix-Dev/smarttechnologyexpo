---
// ============================================================================
//  COMPONENTE BIO MODAL — Modal de "Semblanza" (compartido Insights + Skills)
//  Autor: Donovan Oswaldo Villalba Hernandez
//
//  Modal de semblanza para ponentes/instructores, compartido por Insights y Skills.
//  Funciona con JavaScript vainilla: cualquier elemento con [data-bio-trigger] que
//  lleve los atributos data-bio-name/role/org/bio/photo abre este modal al hacer clic.
//
//  Uso: se renderiza UNA sola vez por página; colócalo cerca del final del <body>
//  o del layout. Los componentes de programa/catálogo solo marcan sus filas con
//  data-bio-* y este modal se encarga de mostrarlas.
//
//  Estilos: clases bm-* en el <style> scoped de abajo (no dependen de insights.css
//  ni skills.css, por ser un componente compartido).
//
//  i18n: los textos ("Cerrar", "Semblanza") salen de los locales vía tr().
// ============================================================================
import { useTranslations, getTranslation } from "../../utils/translations";
const { translations, locale } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") => getTranslation(translations, key, fallback);
---

<!-- Overlay del modal: arranca oculto (hidden); el script lo muestra al abrir.
     Los ids bio-modal-* los rellena el script con los datos del elemento clicado. -->
<div id="bio-modal-overlay" class="bm-overlay" hidden>
  <div class="bm-card" role="dialog" aria-modal="true">
    <div class="bm-header">
      <button id="bio-modal-close" class="bm-close" aria-label={tr("bioModal.close", "Cerrar")}>✕</button>
      <div class="bm-header-row">
        <!-- Avatar: el script le pone la foto como background-image -->
        <span id="bio-modal-avatar" class="bm-avatar"></span>
        <div>
          <div id="bio-modal-name" class="bm-name"></div>
          <div id="bio-modal-role" class="bm-role"></div>
          <span id="bio-modal-org" class="bm-org"></span>
        </div>
      </div>
    </div>
    <div class="bm-body">
      <div class="bm-body-title">
        <span class="bm-body-line"></span>
        <span>{tr("bioModal.title", "Semblanza")}</span>
      </div>
      <p id="bio-modal-text" class="bm-text"></p>
    </div>
  </div>
</div>

<script>
  // initBioModal: cablea el modal una vez cargado el DOM.
  function initBioModal() {
    // Referencias a los nodos que el modal rellena/controla.
    const overlay = document.getElementById('bio-modal-overlay');
    const nameEl = document.getElementById('bio-modal-name');
    const roleEl = document.getElementById('bio-modal-role');
    const orgEl = document.getElementById('bio-modal-org');
    const textEl = document.getElementById('bio-modal-text');
    const avatarEl = document.getElementById('bio-modal-avatar');
    const closeBtn = document.getElementById('bio-modal-close');
    if (!(overlay instanceof HTMLElement)) return;
    const overlayEl = overlay;

    // open: vuelca los datos recibidos en el modal y lo muestra.
    function open(data: { name: string; role: string; org: string; bio: string; photo: string }) {
      if (nameEl) nameEl.textContent = data.name || '';
      if (roleEl) roleEl.textContent = data.role || '';
      if (orgEl) orgEl.textContent = data.org || '';
      if (textEl) textEl.textContent = data.bio || '';
      // Avatar: si hay foto la pinta como fondo; si no, limpia estilos previos.
      if (avatarEl) {
        if (data.photo) {
          avatarEl.style.backgroundImage = `url("${data.photo}")`;
          avatarEl.style.backgroundSize = 'cover';
          avatarEl.style.backgroundPosition = 'center';
          avatarEl.style.backgroundRepeat = 'no-repeat';
        } else {
          avatarEl.style.backgroundImage = '';
          avatarEl.style.backgroundSize = '';
          avatarEl.style.backgroundPosition = '';
          avatarEl.style.backgroundRepeat = '';
        }
      }
      overlayEl.hidden = false;
    }
    // close: oculta el modal.
    function close() {
      overlayEl.hidden = true;
    }

    // Delegación de clics: abre el modal con los data-bio-* del disparador.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement)?.closest('[data-bio-trigger]') as HTMLElement | null;
      if (trigger) {
        open({
          name: trigger.dataset.bioName || '',
          role: trigger.dataset.bioRole || '',
          org: trigger.dataset.bioOrg || '',
          bio: trigger.dataset.bioBio || '',
          photo: trigger.dataset.bioPhoto || '',
        });
      }
    });

    // Cierre: clic en el fondo, botón X o tecla Escape.
    overlayEl.addEventListener('click', (e) => {
      if (e.target === overlayEl) close();
    });
    closeBtn?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  document.addEventListener('DOMContentLoaded', initBioModal);
</script>

<style>
  /* ── OVERLAY (fondo oscuro a pantalla completa) ───────────────────── */
  .bm-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.78);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'Archivo', Helvetica, Arial, sans-serif;
  }

  /* ── TARJETA DEL MODAL ────────────────────────────────────────────── */
  .bm-card {
    max-width: 720px;
    width: 100%;
    max-height: 86vh;
    overflow-y: auto;
    background: #0c0c0c;
    border: 1px solid #262626;
    border-radius: 12px;
  }

  /* ── ENCABEZADO (degradado rojo con avatar y datos) ───────────────── */
  .bm-header {
    position: relative;
    padding: 32px 28px 26px;
    background: linear-gradient(135deg, #5a0f0f 0%, #e2101a 55%, #8b1414 100%);
  }

  /* Botón de cierre (X) en la esquina. */
  .bm-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
  }

  .bm-header-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Avatar circular (fondo por defecto; el script le pone la foto). */
  .bm-avatar {
    width: 76px;
    height: 76px;
    flex: none;
    border-radius: 50%;
    background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0 8px, rgba(0, 0, 0, 0.15) 8px 16px);
    border: 2px solid rgba(255, 255, 255, 0.5);
  }

  .bm-name {
    font-size: 22px;
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
  }

  .bm-role {
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 4px;
  }

  /* Chip de organización (pill oscura). */
  .bm-org {
    display: inline-flex;
    margin-top: 10px;
    padding: 5px 12px;
    background: rgba(0, 0, 0, 0.28);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
  }

  /* ── CUERPO (título "Semblanza" + texto) ──────────────────────────── */
  .bm-body {
    padding: 26px 28px 30px;
  }

  .bm-body-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 15px;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bm-body-line {
    width: 24px;
    height: 2px;
    background: #e2101a;
  }

  /* Texto de la semblanza (respeta saltos de línea con pre-line). */
  .bm-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: #b9b9b9;
    white-space: pre-line;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }
</style>