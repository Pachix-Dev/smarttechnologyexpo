---
import { getRelativeLocaleUrl } from 'astro:i18n'

const currentLocale = Astro.currentLocale || 'es'
const currentPath = Astro.url.pathname
  .replace(/^\/[a-z]{2}\//, '/')
  .replace(/^\//, '')

// URLs para cambiar idioma
const esUrl = getRelativeLocaleUrl('es', currentPath)
const enUrl = getRelativeLocaleUrl('en', currentPath)
---

<div class='language-switcher'>
  <a
    href={esUrl}
    class:list={['lang-link', { active: currentLocale === 'es' }]}
  >
    ES
  </a>
  <a
    href={enUrl}
    class:list={['lang-link', { active: currentLocale === 'en' }]}
  >
    EN
  </a>
</div>

<style>
  .language-switcher {
    display: inline-flex;
    width: auto;
    gap: 0.2rem;
    align-items: center;
    justify-content: center;
    padding: 0.2rem;
    border-radius: 999px;
    border: 1px solid rgba(51, 65, 85, 0.28);
    background: linear-gradient(145deg, rgba(248, 250, 252, 0.96), rgba(226, 232, 240, 0.92));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 8px 14px -14px rgba(15, 23, 42, 0.55);
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    min-width: 2.4rem;
    padding: 0.34rem 0.6rem;
    border-radius: 999px;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgb(15 23 42);
    transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .lang-link:hover {
    background-color: rgba(255, 255, 255, 0.9);
    color: rgb(2 6 23);
    transform: translateY(-1px);
  }

  .lang-link.active {
    background: linear-gradient(135deg, rgb(30 41 59), rgb(2 6 23));
    color: rgb(255 255 255);
    box-shadow: 0 8px 14px -10px rgba(2, 6, 23, 0.9);
    font-weight: 800;
  }

  .lang-link:focus-visible {
    outline: 2px solid rgb(51 65 85);
    outline-offset: 2px;
  }

  @media (min-width: 1024px) {
    .language-switcher {
      width: auto;
    }

    .lang-link {
      min-width: 2.5rem;
      padding: 0.32rem 0.62rem;
      font-size: 0.65rem;
    }
  }
</style>
