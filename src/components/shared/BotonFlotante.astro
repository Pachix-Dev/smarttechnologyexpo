---
import { useTranslations, getTranslation } from "../../utils/translations";

const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const basePath = locale === "en" ? "/en" : "";
const href = `${basePath}/registro`;
const text = tr(
  "botonFlotante.text",
  locale === "en" ? "Register" : "Reg\u00edstrate",
);
const ariaLabel = tr(
  "botonFlotante.ariaLabel",
  locale === "en" ? "Go to registration page" : "Ir a la p\u00e1gina de registro",
);
---

<a href={href} aria-label={ariaLabel} class="floating-register-button">
  <span class="floating-register-button__icon" aria-hidden="true">
   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M15 14c-2.67 0-8 1.33-8 4v2h16v-2c0-2.67-5.33-4-8-4m-9-4V7H4v3H1v2h3v3h2v-3h3v-2m6 2a4 4 0 0 0 4-4a4 4 0 0 0-4-4a4 4 0 0 0-4 4a4 4 0 0 0 4 4"/></svg>
  </span>
  <span class="floating-register-button__text">{text}</span>
  <span class="floating-register-button__arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <path
        d="M5 12h14m-6-6 6 6-6 6"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .floating-register-button {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    max-width: calc(100vw - 2rem);
    min-height: 3.25rem;
    padding: 0.55rem 0.7rem 0.55rem 0.6rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 999px;
    background: #2563eb;
    color: #ffffff;
    box-shadow:
      0 18px 45px rgba(37, 99, 235, 0.42),
      0 8px 18px rgba(255, 255, 255, 0.2);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      filter 180ms ease;
  }

  .floating-register-button::before {
    content: "";
    position: absolute;
    inset: -2px;
    z-index: -2;
    border-radius: inherit;
    background: #2563eb;
    opacity: 0.75;
    animation: floating-register-pulse 2.8s ease-in-out infinite;
  }

  .floating-register-button::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 0%,
      transparent 28%,
      rgba(255, 255, 255, 0.35) 42%,
      transparent 58%,
      transparent 100%
    );
    transform: translateX(-120%);
    animation: floating-register-shine 3.2s ease-in-out infinite;
  }

  .floating-register-button:hover {
    transform: translateY(-3px) scale(1.02);
    filter: saturate(1.08);
    box-shadow:
      0 22px 52px rgba(37, 99, 235, 0.5),
      0 10px 22px rgba(255, 255, 255, 0.26);
  }

  .floating-register-button:focus-visible {
    outline: 4px solid rgba(255, 255, 255, 0.75);
    outline-offset: 4px;
  }

  .floating-register-button__icon,
  .floating-register-button__arrow {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 999px;
  }

  .floating-register-button__icon {
    background: #ffffff;
    color: #2563eb;
    box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.12);
  }

  .floating-register-button__arrow {
    width: 1.85rem;
    height: 1.85rem;
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .floating-register-button svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .floating-register-button__text {
    white-space: nowrap;
  }

  @keyframes floating-register-pulse {
    0%,
    100% {
      opacity: 0.48;
      transform: scale(1);
    }

    50% {
      opacity: 0.95;
      transform: scale(1.08);
    }
  }

  @keyframes floating-register-shine {
    0%,
    62% {
      transform: translateX(-120%);
    }

    100% {
      transform: translateX(120%);
    }
  }

  @media (min-width: 640px) {
    .floating-register-button {
      right: 1.5rem;
      bottom: 1.5rem;
      min-height: 3.75rem;
      padding: 0.65rem 0.85rem 0.65rem 0.7rem;
      font-size: 0.86rem;
    }

    .floating-register-button__icon {
      width: 2.55rem;
      height: 2.55rem;
    }

    .floating-register-button__arrow {
      width: 2.1rem;
      height: 2.1rem;
    }

    .floating-register-button svg {
      width: 1.35rem;
      height: 1.35rem;
    }
  }

  @media (max-width: 380px) {
    .floating-register-button {
      gap: 0.45rem;
      padding-right: 0.55rem;
      font-size: 0.68rem;
    }

    .floating-register-button__arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-register-button,
    .floating-register-button::before,
    .floating-register-button::after {
      animation: none;
      transition: none;
    }
  }
</style>
