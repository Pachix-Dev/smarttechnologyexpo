---

<StickyHeader
  class="fixed left-0 right-0 top-0 z-50 w-full border-b border-slate-200/80 bg-white text-sm font-semibold text-slate-700 transition-all duration-300 lg:flex lg:items-center lg:justify-between lg:px-8 lg:py-3"
  defaultClass="nav-static"
  activeClass="nav-scrolled"
>
  <Astronav closeOnClick>
    <div
      class="flex w-full items-center justify-between px-4 py-3 lg:w-auto lg:px-0 lg:py-0"
    >
      <a href={`${basePath}/`}>
        <img
          src="/img/logo_ste_2026.webp"
          alt="Smart Technology Expo"
          loading="lazy"
          decoding="async"
          class="h-auto w-28 lg:w-32"
        />
      </a>
      <div
        class="block rounded-xl border border-slate-200 bg-white p-2 lg:hidden"
      >
        <MenuIcon class="h-6 w-6 text-slate-700" />
      </div>
    </div>
    <MenuItems
      class="hidden w-full px-4 pb-4 lg:flex lg:w-auto lg:px-0 lg:pb-0"
    >
      <ul
        class="flex w-full flex-col gap-2 rounded-2xl bg-white/95 p-3 uppercase text-[11px] tracking-[0.08em] ring-1 ring-slate-200 lg:w-auto lg:flex-row lg:items-center lg:gap-1 lg:rounded-none lg:bg-transparent lg:p-0 lg:ring-0"
      >
        {
          menu.map((menuItem) => (
            <li class="w-full lg:w-auto">
              {menuItem.items ? (
                <Dropdown class="group w-full lg:w-auto">
                  <button class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-slate-800 transition-colors hover:bg-slate-100 hover:text-red-700 lg:w-auto lg:justify-start lg:gap-1 lg:px-2 lg:py-1.5">
                    <span>{menuItem.title}</span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="2.4"
                      stroke="currentColor"
                      class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                      />
                    </svg>
                  </button>
                  <DropdownItems class="relative">
                    <div class="mt-1 rounded-xl border border-slate-200 bg-white p-2 lg:absolute lg:left-1/2 lg:top-9 lg:mt-0 lg:min-w-64 lg:-translate-x-1/2 lg:rounded-2xl lg:p-3">
                      <ul class="space-y-1">
                        {menuItem.items.map((subItem) => (
                          <li>
                            {subItem.items ? (
                              <DropdownSubmenu class="group/submenu">
                                <button class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-slate-700 transition-colors hover:bg-slate-100 hover:text-red-700">
                                  <span>{subItem.title}</span>
                                  <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="3"
                                    stroke="currentColor"
                                    class="mt-0.5 h-3 w-3 transition-transform duration-200 group-open/submenu:rotate-180 lg:group-open/submenu:-rotate-90"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M8.25 4.5l7.5 7.5-7.5 7.5"
                                    />
                                  </svg>
                                </button>
                                <DropdownItems class="relative">
                                  <ul class="mt-1 space-y-1 border-l border-slate-200 pl-2 lg:absolute lg:left-full lg:top-0 lg:mt-0 lg:w-52 lg:rounded-xl lg:border lg:bg-white lg:p-2">
                                    {subItem.items.map((nestedSubItem) => (
                                      <li>
                                        {nestedSubItem.items ? (
                                          <DropdownSubmenu class="group/nestedsubmenu">
                                            <button class="flex w-full items-center justify-between rounded-lg px-3 py-2 text-left text-slate-700 transition-colors hover:bg-slate-100 hover:text-red-700">
                                              <span>{nestedSubItem.title}</span>
                                              <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke-width="3"
                                                stroke="currentColor"
                                                class="mt-0.5 h-3 w-3 transition-transform duration-200 group-open/nestedsubmenu:rotate-180 lg:group-open/nestedsubmenu:-rotate-90"
                                              >
                                                <path
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  d="M8.25 4.5l7.5 7.5-7.5 7.5"
                                                />
                                              </svg>
                                            </button>
                                            <DropdownItems class="relative">
                                              <ul class="mt-1 space-y-1 border-l border-slate-200 pl-2 lg:absolute lg:left-full lg:top-0 lg:mt-0 lg:w-52 lg:rounded-xl lg:border lg:bg-white lg:p-2">
                                                {nestedSubItem.items.map(
                                                  (deepSubItem) => (
                                                    <li>
                                                      <a
                                                        href={
                                                          deepSubItem?.target
                                                            ? deepSubItem.href
                                                            : `${basePath}${deepSubItem.href}`
                                                        }
                                                        {...(deepSubItem.target && {
                                                          target:
                                                            deepSubItem.target,
                                                          rel: "noopener noreferrer",
                                                        })}
                                                        class="block rounded-lg px-3 py-2 text-slate-700 transition-colors hover:bg-slate-100 hover:text-red-700"
                                                      >
                                                        {deepSubItem.title}
                                                      </a>
                                                    </li>
                                                  ),
                                                )}
                                              </ul>
                                            </DropdownItems>
                                          </DropdownSubmenu>
                                        ) : (
                                          <a
                                            href={
                                              nestedSubItem?.target
                                                ? nestedSubItem.href
                                                : `${basePath}${nestedSubItem.href}`
                                            }
                                            {...(nestedSubItem.target && {
                                              target: nestedSubItem.target,
                                              rel: "noopener noreferrer",
                                            })}
                                            class="block rounded-lg px-3 py-2 text-slate-700 transition-colors hover:bg-slate-100 hover:text-red-700"
                                          >
                                            {nestedSubItem.title}
                                          </a>
                                        )}
                                      </li>
                                    ))}
                                  </ul>
                                </DropdownItems>
                              </DropdownSubmenu>
                            ) : (
                              <a
                                href={
                                  subItem?.target
                                    ? subItem.href
                                    : `${basePath}${subItem.href}`
                                }
                                {...(subItem.target && {
                                  target: subItem.target,
                                  rel: "noopener noreferrer",
                                })}
                                class="block rounded-lg px-3 py-2 text-slate-700 transition-colors hover:bg-slate-100 hover:text-red-700"
                              >
                                {subItem.title}
                              </a>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </DropdownItems>
                </Dropdown>
              ) : (
                <a
                  href={
                    menuItem?.target
                      ? menuItem.href
                      : `${basePath}${menuItem.href}`
                  }
                  {...(menuItem.target && {
                    target: menuItem.target,
                    rel: "noopener noreferrer",
                  })}
                  class="block rounded-lg px-3 py-2 text-slate-800 transition-colors hover:bg-slate-100 hover:text-red-700 lg:px-2 lg:py-1.5"
                >
                  {menuItem.title}
                </a>
              )}
            </li>
          ))
        }
        <div
          class="mt-2 flex w-auto sm:w-auto justify-center rounded-xl sm:border sm:border-slate-300 sm:bg-gradient-to-r sm:from-slate-100 sm:via-slate-50 sm:to-slate-200 px-2 py-1.5 lg:mt-0 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0"
        >
          <LanguageSwitcher />
        </div>
      </ul>
    </MenuItems>
  </Astronav>
</StickyHeader>
