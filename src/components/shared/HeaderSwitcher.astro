---
// ============================================================================
//  COMPONENTE HEADER SWITCHER — Selector Conferencias/Talleres (compartido)
//  Autor: Donovan Oswaldo Villalba Hernandez
//
//  Header sticky compartido con el conmutador de pestañas Conferencias/Talleres.
//  Lo usan los heros de Insights y Skills para saltar entre ambos escenarios.
//
//  Uso: <HeaderSwitcher active="conferencias" />  o  active="talleres".
//  Los enlaces asumen las rutas /insights y /skills (con prefijo /en en inglés);
//  ajusta los href a tu enrutamiento si cambian.
//
//  Estilos: clases hs-* en el <style> scoped de abajo.
//
//  i18n: los textos de las pestañas salen de los locales vía tr('clave', 'fallback').
// ============================================================================

import { useTranslations, getTranslation } from "../../utils/translations";

export interface Props {
  active?: 'conferencias' | 'talleres';   // pestaña activa
  navbarOffset?: number;                   // desplazamiento del sticky (bajo tu navbar)
}

const { active = 'conferencias', navbarOffset = 75 } = Astro.props;
// Banderas de pestaña activa (para aplicar la clase --active).
const isConf = active === 'conferencias';
const isSkills = active === 'talleres';
const { translations, locale } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") => getTranslation(translations, key, fallback);
// Prefijo de ruta según idioma (/en para inglés, vacío para español).
const base = locale === 'en' ? '/en' : '';
---

<!-- Header sticky: el top se fija inline con navbarOffset para quedar bajo tu navbar -->
<header class="hs-header" style={`top:${navbarOffset}px`}>
  <div class="hs-inner">
    <!-- Conmutador de pestañas: la activa lleva la clase hs-tab--active -->
    <div class="hs-tabs">
      <a href={`${base}/insights`} class={isConf ? 'hs-tab hs-tab--active' : 'hs-tab'}>{tr("programSwitch.conferences", "CONFERENCIAS")}</a>
      <a href={`${base}/skills`} class={isSkills ? 'hs-tab hs-tab--active' : 'hs-tab'}>{tr("programSwitch.workshops", "TALLERES")}</a>
    </div>
  </div>
</header>

<style>
  /* ── HEADER (sticky) ──────────────────────────────────────────────── */
  .hs-header {
    position: sticky;
    top: 0; /* overridden inline via navbarOffset prop */
    z-index: 40; /* keep below your main navbar (typically z-index 50+) */
    background: #000;
    border-bottom: 1px solid rgba(0, 0, 0, 0.4);
    font-family: 'Archivo', Helvetica, Arial, sans-serif;
  }

  /* Contenedor interno: alinea el conmutador a la derecha. */
  .hs-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    height: 71px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  /* ── CONMUTADOR DE PESTAÑAS ───────────────────────────────────────── */
  .hs-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.32);
    padding: 4px;
    border-radius: 3px;
    flex: none;
  }

  .hs-tab {
    padding: 9px 18px;
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    border: none;
    border-radius: 2px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  /* Pestaña activa: fondo blanco, texto negro. */
  .hs-tab--active {
    background: #fff;
    color: #000;
    font-weight: 800;
  }
</style>