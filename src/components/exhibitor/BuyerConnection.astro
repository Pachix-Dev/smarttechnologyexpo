---
import { useTranslations, getTranslation } from "../../utils/translations";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);


const benefits = locale === "en"
  ? [
      {
        title: "The Bajio-Occidente is now the engine of industrial growth in the country",
      },
      {
        title: "Innovation and talent ecosystem",
      },
      {
        title: "International connectivity with Canada, Europe, and the U.S.",
      },
      {
        title: "Expo Guadalajara: world-class infrastructure",
      },
      {
        title: "Extensive business collaboration network",
      }
    ]
  : [
      {
        title: "El Bajío-Occidente es hoy el motor del crecimiento industrial del país",
      },
      {
        title: "Ecosistema de innovación y talento",
      },
      {
        title: "Conectividad internacional con Canadá, Europa y EE. UU.",
      },
      {
        title: "Expo Guadalajara: infraestructura de clase mundial",
      },
      {
        title: "Amplia red de colaboración empresarial",
      }
    ];
 
---

<section
  class="relative py-8 md:py-4 bg-linear-to-b from-gray-50 to-white overflow-hidden"
>
  <div class="container mx-auto px-4 relative z-10">
    <!-- Hero Section -->
    <div class="max-w-6xl mx-auto">

      <!-- Sede Card -->
      <div
        class="relative overflow-hidden rounded-3xl shadow-2xl group"
        data-aos="fade-up"
      >
        <div class="grid md:grid-cols-2 gap-0">
          <!-- Imagen de Guadalajara -->
          <div
            class="relative h-64 md:h-auto overflow-hidden"
            data-aos="fade-right"
          >
            <img
              src="/img/guadalajara.webp"
              alt="Guadalajara"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
            />
            <div
              class="absolute inset-0 bg-linear-to-r from-[#c7312a]/10 to-[#8a2b23]/10 mix-blend-multiply"
            >
            </div>

            <!-- Badge flotante -->
            <div class="absolute top-6 left-6">
              <div
                class="inline-flex items-center gap-2 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-full shadow-lg"
              >
                <svg
                  class="w-5 h-5 text-[#c7312a]"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span class="font-bold text-sm text-gray-900">
                  {tr("beExhibitor.sede")}
                </span>
              </div>
            </div>
          </div>
          <!-- Contenido -->
          <div
            class="relative bg-white p-8 md:p-12 flex flex-col justify-center"
            data-aos="fade-left"
          >
            <div
              class="absolute top-0 right-0 w-32 h-32 bg-[#c7312a]/5 rounded-full -translate-y-10 translate-x-10"
            >
            </div>

            <div class="relative">
              <div class="inline-flex items-center gap-2 mb-6">
                <div
                  class="w-1 h-12 bg-linear-to-b from-[#c7312a] to-[#8a2b23] rounded-full"
                >
                </div>
                <div>
                  <p
                    class="text-sm font-bold text-[#c7312a] uppercase tracking-wider"
                  >
                    {locale === "en" ? "Next Epicenter" : "Próximo Epicentro"}
                  </p>
                  <p class="text-xs text-gray-600">{locale === "en" ? "Industrial Innovation" : "Innovación Industrial"}</p>
                </div>
              </div>

              <h2
                class="text-3xl md:text-4xl lg:text-6xl font-black text-gray-900 leading-tight"
              >
                Guadalajara
              </h2><br />
              <h3
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 leading-tight"
              >
                {tr("expositorsSection.sede_description")}
              </h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Benefits Section -->
      <div class="mt-16 md:mt-20">
        <div class="relative overflow-hidden rounded-[2rem] border border-[#c7312a]/10 bg-gradient-to-br from-[#fff7f7] via-white to-[#fff3f2] p-4 sm:p-6 md:p-8 shadow-[0_25px_80px_-30px_rgba(199,49,42,0.35)]">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(199,49,42,0.09),_transparent_55%)]"></div>
          <div class="relative grid grid-cols-2 gap-3 sm:gap-4 md:gap-5 lg:grid-cols-3 xl:grid-cols-5">
            {benefits.map((benefit, index) => (
              <div
                class="group relative overflow-hidden rounded-[1.25rem] border border-gray-200/80 bg-white p-4 shadow-[0_10px_25px_-18px_rgba(0,0,0,0.28)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_10px_24px_-16px_rgba(199,49,42,0.2)] hover:border-[#c7312a]/15 sm:p-5 md:p-6"
                data-aos="fade-up"
                data-aos-delay={index * 100}
              >
                <div class="absolute inset-x-0 top-0 h-[2px] bg-linear-to-r from-[#c7312a]/70 via-[#e85d4b]/60 to-[#8a2b23]/70"></div>
                <div class="absolute -right-6 -top-6 h-16 w-16 rounded-full bg-[#c7312a]/6 transition-all duration-200 group-hover:scale-105"></div>
                <div class="relative mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-[#c7312a]/10 to-[#8a2b23]/8 text-[#c7312a] shadow-inner">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h3 class="relative text-xs sm:text-lg font-semibold leading-snug text-gray-900">
                  {benefit.title}
                </h3>
                <div class="mt-4 h-1.5 w-24 rounded-full bg-gradient-to-r from-[#c7312a]/40 to-transparent"></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <style>
    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</section>
