---
import { ExhibitorSummary } from "./ExhibitorSummary.jsx";
import { directory2026 } from "../../data/constans_directory_2026.js";

import { useTranslations, getTranslation } from "../../utils/translations";
const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const currentLanguage = locale === "es" ? "es" : "en";
const labels =
  currentLanguage === "es"
    ? {
        title: "Directorio de Expositores 2026",
        description:
          "Explora las empresas participantes, consulta su stand y revisa sus datos de contacto antes de visitar Smart Technology Expo.",
      }
    : {
        title: "Exhibitor Directory 2026",
        description:
          "Explore participating companies, check their booth location, and review contact details before visiting Smart Technology Expo.",
      };
---

<section class="bg-[#f5f6f8]">
  <header class="relative isolate overflow-hidden bg-[#151515]">
    <img
      src="/img/smart_back.webp"
      alt=""
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.88),rgba(0,0,0,0.62)_54%,rgba(227,6,19,0.74))]"></div>
    <div class="mx-auto flex min-h-[190px] w-full max-w-[1240px] flex-col justify-center items-center px-5 py-2 sm:px-8 sm:py-6 lg:px-10 lg:py-10">
      <div class="max-w-4xl text-center">
        <h1 class="text-[1.8rem] font-black uppercase leading-none tracking-normal text-white sm:text-6xl lg:text-5xl">
          {labels.title}
        </h1>
        <p class="mt-3 text-sm font-semibold leading-6 text-white sm:mt-5 sm:text-[0.95rem] sm:leading-7">
          {labels.description}
        </p>
      </div>
    </div>
  </header>
  <div class="mx-auto my-2 px-1 w-full max-w-[860px] sm:my-4 sm:px-8 lg:px-10">
    <img
      src={currentLanguage === "es"
        ? "/img/robustel_es.webp"
        : "/img/robustel_en.webp"}
      alt="Robustel"
      class="block h-auto w-full"
      loading="lazy"
    />
  </div>
  <ExhibitorSummary
    exhibitors={directory2026}
    language={currentLanguage}
    client:only="react"
  />
</section>
