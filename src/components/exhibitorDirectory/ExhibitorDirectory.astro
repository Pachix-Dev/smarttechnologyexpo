---
import { ExhibitorSummary } from "./ExhibitorSummary.jsx";
import { directory2026 } from "../../data/constans_directory_2026.js";

import { useTranslations, getTranslation } from "../../utils/translations";
const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const currentLanguage = locale === "es" ? "es" : "en";
const basePath = locale === "en" ? "/en" : "";

const labels =
  currentLanguage === "es"
    ? {
        title: "Directorio de Expositores 2026",
        description:
          "Explora las empresas participantes, consulta su stand y revisa sus datos de contacto antes de visitar Smart Technology Expo.",
      }
    : {
        title: "Exhibitor Directory 2026",
        description:
          "Explore participating companies, check their booth location, and review contact details before visiting Smart Technology Expo.",
      };
---

<section class="bg-[#f5f6f8]">
  <header class="relative isolate overflow-hidden bg-[#151515]">
    <img
      src="/img/smart_back.webp"
      alt=""
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      loading="eager"
    />
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(0,0,0,0.88),rgba(0,0,0,0.62)_54%,rgba(227,6,19,0.74))]"
    >
    </div>
    <div
      class="mx-auto flex min-h-[190px] w-full max-w-[1240px] flex-col justify-center items-center px-5 py-2 sm:px-8 sm:py-6 lg:px-10 lg:py-10"
    >
      <div class="max-w-4xl text-center">
        <h1
          class="text-[1.8rem] font-black uppercase leading-none tracking-normal text-white sm:text-6xl lg:text-5xl"
        >
          {labels.title}
        </h1>
        <p
          class="mt-3 text-sm font-semibold leading-6 text-white sm:mt-5 sm:text-[0.95rem] sm:leading-7"
        >
          {labels.description}
        </p>
      </div>
    </div>
  </header>
  <div class="mx-auto my-2 px-1 w-full max-w-[860px] sm:my-4 sm:px-8 lg:px-10">
    <img
      src={currentLanguage === "es"
        ? "/img/robustel_es.webp"
        : "/img/robustel_en.webp"}
      alt="Robustel"
      class="block h-auto w-full"
      loading="lazy"
    />
  </div>

  <div
    class="mx-auto flex w-full max-w-[1600px] flex-wrap sm:flex-col gap-4 px-4
         lg:flex-row lg:items-start lg:gap-6"
  >
    <!-- Primer aside -->
    <aside
      class="order-1 w-auto lg:sticky lg:top-[88px] lg:order-1 lg:w-[140px] lg:shrink-0 2xl:w-[160px] flex sm:flex-col gap-1 lg:gap-2"
    >
      <img
        src={currentLanguage === "es"
          ? "/img/banner_telcel_empresas_es.webp"
          : "/img/banner_telcel_empresas_en.webp"}
        alt="Telcel Empresas"
        class="mx-auto h-auto w-[90px] object-contain
             sm:w-[140px] lg:w-full"
      />
      <a href={`${basePath}/expositor-smarttechnologyexpo`}>
        <img
          src={currentLanguage === "es"
            ? "/img/banner_ste_es_01.webp"
            : "/img/banner_ste_en_01.webp"}
          alt="Expositor Smart Technology Expo"
          class="mx-auto h-auto w-[90px] object-contain
             sm:w-[140px] lg:w-full"
        />
      </a>
    </aside>

    <!-- Contenido principal -->
    <main class="order-3 min-w-0 w-full lg:order-2 lg:flex-1">
      <ExhibitorSummary
        exhibitors={directory2026}
        language={currentLanguage}
        client:only="react"
      />
    </main>

    <!-- Segundo aside -->
    <aside
      class="order-2 w-auto lg:sticky lg:top-[88px] lg:order-3 lg:w-[140px] lg:shrink-0 2xl:w-[160px]"
    >
      <img
        src={currentLanguage === "es"
          ? "/img/banner_backoff_es.webp"
          : "/img/banner_backoff_en.webp"}
        alt="Backoffice"
        class="mx-auto h-auto w-[90px] object-contain
             sm:w-[140px] lg:w-full"
      />
    </aside>
  </div>
</section>
