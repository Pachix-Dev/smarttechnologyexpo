---
// src/components/drone-innovators/DroneHero.astro
import { useTranslations, getTranslation } from '../../utils/translations'

export interface Props {
  locale?: string
}

const { locale, translations } = await useTranslations(Astro.props, Astro)
const tr = (key: string, fallback: string = '') =>
  getTranslation(translations, key, fallback)

const dateBadge = locale === 'en'
  ? '/img/drone-innovators/date_en-hero.webp'
  : '/img/drone-innovators/date_es-hero.webp'
---

<section class="dh-hero">

  <img
    src="/img/drone-innovators/bg-hero.webp"
    alt=""
    class="dh-bg"
    aria-hidden="true"
  />

  <div class="dh-inner">

    <div class="dh-left" data-aos="fade-right" data-aos-duration="900">
      <img
        src="/img/drone-innovators/logo-hero.webp"
        alt="Drone Innovators Forum MX"
        class="dh-logo"
      />
    </div>

    <div class="dh-right" data-aos="fade-left" data-aos-duration="900" data-aos-delay="200">
      <img
        src={dateBadge}
        alt={locale === 'en'
          ? 'November 18–20, 2026 · Expo Guadalajara'
          : '18–20 Noviembre 2026 · Expo Guadalajara'}
        class="dh-date"
      />
    </div>

  </div>

</section>

<style>
  .dh-hero {
    position: relative;
    width: 100%;
    background: #0b1627;
    overflow: hidden;
  }

  .dh-bg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .dh-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.46fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    width: 100%;
    max-width: 1600px;
    box-sizing: border-box;
    margin: 0 auto;
    padding: clamp(1.25rem, 2.5vw, 2.5rem) clamp(1rem, 5vw, 6rem);
  }

  .dh-left,
  .dh-right {
    min-width: 0;
  }

  .dh-logo,
  .dh-date {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .dh-inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 0.75rem;
      padding: 1.25rem 1rem;
    }

    .dh-bg {
      object-position: 30% bottom;
    }
  }
</style>
