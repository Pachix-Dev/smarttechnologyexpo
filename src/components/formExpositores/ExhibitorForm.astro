---
import { ContactForm } from "./ContactForm";
import { useTranslations , getTranslation } from "../../utils/translations";
const { translations, locale } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = '') =>
  getTranslation(translations, key, fallback);


const currentLanguage = locale === 'es' ? 'es' : 'en';

---
<section class="my-12 p-6 rounded-lg bg-zinc-100">
  <h2 class="text-center text-2xl md:text-3xl font-black text-gray-900 mb-4" set:html={tr('expositorsSection.title_section')}></h2>
  <ContactForm language={currentLanguage}  client:visible  />
</section>