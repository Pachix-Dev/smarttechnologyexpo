---
import { useTranslations, getTranslation } from "../../utils/translations";
//Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);

//Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

import { mediaPlanito, strategicPartners, mediaGold, sponsorsDiamond, sponsorsBronze } from "../../logos.js";
---

<section class="my-10 p-2">

<!-- PATROCINADORES GOLD -->
<div class="mx-auto mb-0 sm:mb-10">
    <h2 class="w-fit mx-auto square_red font-extrabold text-xl md:text-4xl uppercase py-5 px-10 text-black font-montserrat-extra-bold-italic text-center">
      {locale === "es" ? "PATROCINADORES DIAMANTE" : "DIAMOND SPONSORS"}
    </h2>
    <div class="flex justify-center w-full">
      <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-1 lg:grid-cols-1 gap-2 sm:gap-8 place-items-center place-content-center max-w-4xl">
        {
          sponsorsDiamond.map((partner, index) => (
            <div class="flex justify-center items-center">
              <img
                src={partner.src}
                alt={partner.alt}
                class="w-[200px] sm:w-[280px] object-contain" 
              />
            </div>
          ))
        }
      </div>
    </div>
</div>

<!-- PATROCINADORES BRONCE -->
<div class="mx-auto mb-0 sm:mb-10">
    <h2 class="w-fit mx-auto square_red font-extrabold text-xl md:text-4xl uppercase py-5 px-10 text-black font-montserrat-extra-bold-italic text-center">
      {locale === "es" ? "PATROCINADORES BRONCE" : "BRONZE SPONSORS"}
    </h2>
    <div class="flex justify-center w-full">
      <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-1 lg:grid-cols-1 gap-2 sm:gap-8 place-items-center place-content-center max-w-4xl">
        {
          sponsorsBronze.map((partner, index) => (
            <div class="flex justify-center items-center">
              <img
                src={partner.src}
                alt={partner.alt}
                class="w-[200px] sm:w-[280px] object-contain" 
              />
            </div>
          ))
        }
      </div>
    </div>
</div>

<!-- ALIADOS ESTRATEGICOS -->
<div class="mx-auto">
    <h2 class="w-fit mx-auto square_red font-extrabold text-xl md:text-4xl uppercase py-5 px-10 text-black font-montserrat-extra-bold-italic text-center">
      {tr("home.strategic_partners")}
    </h2>
    <div class="flex justify-center w-full">
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-2 sm:gap-8 place-items-center place-content-center max-w-4xl">
        {
          strategicPartners.map((partner, index) => (
            <div class="flex justify-center items-center">
              <img
                src={partner.src}
                alt={partner.alt}
                class="w-auto object-contain" 
              />
            </div>
          ))
        }
      </div>
    </div>
</div>

<!-- ALIADOS PLATINUM -->
<div class="mx-auto">
    <h2
      class="w-fit mx-auto square_red font-extrabold text-xl md:text-4xl uppercase py-5 px-10 text-black font-montserrat-extra-bold-italic text-center"
    >
      {tr("home.platinum_allies")}
    </h2>
    <div class="flex justify-center w-full">
      <div class="grid grid-cols-3 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-3 gap-8 place-items-center place-content-center max-w-3xl">
        {
          mediaPlanito.map((medio, index) => (
            <div class="flex justify-center items-center">
              <img
                src={medio.src}
                alt={medio.alt}
                class="w-auto object-contain"
              />
            </div>
          ))
        }
      </div>
    </div>
</div>

<!-- MEDIOS GOLD -->
<div class="mx-auto">
    <h2
      class="w-fit mx-auto square_red font-extrabold text-xl md:text-4xl uppercase py-5 px-10 text-black font-montserrat-extra-bold-italic text-center"
    >
      {tr("home.media_allies")}
    </h2>
    <div class="flex justify-center w-full">
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-2 gap-8 place-items-center place-content-center max-w-xl">
        {
          mediaGold.map((medio, index) => (
            <div class="flex justify-center items-center">
              <img
                src={medio.src}
                alt={medio.alt}
                class="w-auto object-contain"
              />
            </div>
          ))
        }
      </div>
    </div>
</div>

</section>
