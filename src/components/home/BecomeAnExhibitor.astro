---
import { useTranslations } from "../../utils/translations";

const { locale } = await useTranslations(Astro.props, Astro);

const base = locale === "es" ? "" : "/en";
const factsheetHref =
  locale === "es"
    ? "/files/STE_FACTSHEET_ESP 2026_v2_030826.pdf"
    : "/files/STE_FACTSHEET_ENG_2026_v2_030826.pdf";

const sponsorsFile = locale === "es"
  ? "/files/STE26_PATROCINIOS_ESP_110826.pdf"
  : "/files/STE26_PATROCINIOS_ENG_110826.pdf";

const titleLineOne = locale === "es" ? "CONVIERTETE" : "BECOME";
const titleLineTwo = locale === "es" ? "EN" : "AN";
const titleLineThree = locale === "es" ? "EXPOSITOR" : "EXHIBITOR";
const textMoreInfo =
  locale === "es" ? "Da click para mas información" : "Click for more information";

const cards = [
  {
    eyebrow: locale === "es" ? "COMERCIAL" : "COMMERCIAL",
    title: "FACTSHEET",
    description:
      locale === "es"
        ? "Descarga toda la información que necesitas para impulsar tu presencia como expositor. "
        : "Download all the information you need to boost your presence as an exhibitor.",
    href: factsheetHref,
    download: true,
    icon: "document",
  },
  {
    eyebrow: locale === "es" ? "UBICACION" : "LOCATION",
    title: locale === "es" ? "PLANO" : "FLOORPLAN",
    description:
      locale === "es"
        ? "Consulta la distribución del piso de exhibición."
        : "Review the exhibition floor layout.",
    href: `${base}/plano`,
    icon: "map",
  },
  {
    eyebrow: locale === "es" ? "VISIBILIDAD" : "VISIBILITY",
    title: locale === "es" ? "QUIERO SER PATROCINADOR" : "BECOME A SPONSOR",
    description:
      locale === "es"
        ? "Impulsa la presencia de tu marca ante compradores y líderes industriales."
        : "Boost your brand presence with buyers and industry leaders.",
    href: sponsorsFile,
    download: true,
    icon: "sponsor",
    featured: true,
  },
];
---

<section class="w-full bg-[#1d1d1b] px-4 py-8 text-white font-[Montserrat] sm:px-6 lg:px-8">
  <div class="mx-auto grid max-w-6xl gap-7 lg:grid-cols-2 lg:items-center">
    <div class="flex items-start gap-4 sm:gap-5">
      <span
        class="mt-2 block size-5 shrink-0 bg-[#ed001b] sm:mt-3 sm:size-7"
        aria-hidden="true"
      ></span>
      <a
        id="become-exhibitor-title"
        class="group flex flex-col gap-5 text-white uppercase no-underline"
        href={`${base}/expositor-smarttechnologyexpo`}
      >
        <span class="text-[1.85rem] font-light tracking-normal sm:text-4xl xl:text-6xl">
          <span>{titleLineOne}</span><br>
          <span>{titleLineTwo}
            <strong class="font-extrabold"> {titleLineThree}</strong>
          </span>
        </span>

        <span class="inline-flex items-center gap-2 text-[10px] font-medium tracking-[0.12em] text-white transition duration-200 group-hover:text-red-500 hover:underline underline-offset-4 sm:text-xl">
          {textMoreInfo}
          <svg
            class="size-5 shrink-0 transition duration-200 group-hover:translate-x-1 sm:size-7"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M4 11v2h12l-5.5 5.5l1.42 1.42L19.84 12l-7.92-7.92L10.5 5.5L16 11z"
            ></path>
          </svg>
        </span>
      </a>
    </div>

    <div class="grid grid-cols-2 gap-2 sm:gap-3 xl:grid-cols-3">
      {
        cards.map((card) => (
          <a
            href={card.href}
            target={card.download ? "_blank" : undefined}
            rel={card.download ? "noopener noreferrer" : undefined}
            class:list={[
              "group relative flex min-h-[132px] flex-col justify-between overflow-hidden rounded-[8px] border bg-white p-3 text-[#1d1d1b] no-underline shadow-[0_10px_24px_rgba(0,0,0,0.14)] transition duration-200 hover:-translate-y-1 focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-white sm:min-h-[178px] sm:p-5",
              card.featured
                ? "border-[#ed001b]"
                : "border-white/20",
            ]}
          >
            <div class="flex items-start sm:justify-between gap-2 sm:gap-5">
              <span class="text-[#ed001b]" aria-hidden="true">
                {card.icon === "map" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18.5L9 17l-6 3V7l6-3l6 3l6-3v7.5M9 4v13m6-10v5.5m6.121 7.621a3 3 0 1 0-4.242 0Q17.506 20.749 19 22q1.577-1.335 2.121-1.879M19 18v.01"/></svg>
                )}

                {card.icon === "document" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 1024 1024"><path fill="currentColor" d="M832 384H576V128H192v768h640zm-26.5-64L640 154.5V320zM160 64h480l256 256v608a32 32 0 0 1-32 32H160a32 32 0 0 1-32-32V96a32 32 0 0 1 32-32m160 448h384v64H320zm0-192h160v64H320zm0 384h384v64H320z"/></svg>
                )}

                {card.icon === "sponsor" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 28 28"><path fill="currentColor" d="M14.13 24.462c.318.509.694.977 1.12 1.395q-1.077.142-2.25.143c-5.79 0-10-2.567-10-6.285V19a3 3 0 0 1 3-3h8.5a7.5 7.5 0 0 0-.876 1.5H6a1.5 1.5 0 0 0-1.493 1.355L4.5 19v.715c0 2.674 3.389 4.785 8.5 4.785q.58 0 1.13-.038M13 2a6 6 0 1 1 0 12a6 6 0 0 1 0-12m0 1.5a4.5 4.5 0 1 0 0 9a4.5 4.5 0 0 0 0-9m14 17a6.5 6.5 0 1 1-13 0a6.5 6.5 0 0 1 13 0m-5.786-3.96a.742.742 0 0 0-1.428 0l-.716 2.298h-2.318c-.727 0-1.03.97-.441 1.416l1.875 1.42l-.716 2.298c-.225.721.567 1.32 1.155.875l1.875-1.42l1.875 1.42c.588.446 1.38-.154 1.155-.875l-.716-2.298l1.875-1.42c.588-.445.286-1.416-.441-1.416H21.93z"/></svg>
                )}
              </span>

              <span class="text-[#ed001b] transition duration-200 group-hover:translate-x-1">
                <svg class="size-5 sm:size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m13 5 7 7-7 7" />
                </svg>
              </span>
            </div>

            <div class="mt-3 sm:mt-5">
              <p class="text-[8px] font-black tracking-[0.16em] text-[#ed001b] uppercase sm:text-[10px] sm:tracking-[0.2em]">
                {card.eyebrow}
              </p>
              <h3 class="mt-1.5 text-[0.82rem] leading-tight font-black tracking-normal uppercase text-[#1d1d1b] sm:mt-2 sm:text-xl xl:text-[1rem]">
                {card.title}
              </h3>
              <p class="mt-2 hidden text-sm leading-6 text-gray-600 sm:block">
                {card.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
    
  </div>
</section>

<style>
  @font-face {
    font-family: "Montserrat";
    src: url("/fonts/Montserrat/static/Montserrat-Regular.ttf")
      format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Montserrat";
    src: url("/fonts/Montserrat/static/Montserrat-ExtraBold.ttf")
      format("truetype");
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
</style>
