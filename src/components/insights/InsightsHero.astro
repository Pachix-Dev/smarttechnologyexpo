---
// ============================================================================
//  COMPONENTE INSIGHTS HERO — Escenario SMART INSIGHTS (Conferencias)
//  Autor: Donovan Oswaldo Villalba Hernandez
//
//  Cabecera (header/switcher) + hero de la página interior de SMART INSIGHTS.
//  Es la portada del escenario de conferencias: eyebrow, título en 2 líneas,
//  descripción y una fila de "chips" con datos clave (fechas, sede, formato).
//
//  Estructura visual (de fondo a frente):
//    - HeaderSwitcher compartido (marca activa: "conferencias").
//    - Fondo negro con textura de puntos (.ih-dots) y un glow rojo (.ih-glow).
//    - Contenido: eyebrow con línea, título Smart/Insights, descripción y chips.
//
//  Props: todo es configurable desde fuera (eyebrow, title1/2, description,
//         chips); si no se pasa, se usan los valores por defecto de abajo.
//
//  i18n: los textos por defecto salen de los locales vía tr('clave', 'fallback').
//        Si la clave no existe en el idioma actual, se usa el texto de respaldo.
// ============================================================================
import HeaderSwitcher from '../shared/HeaderSwitcher.astro';
import { useTranslations, getTranslation } from "../../utils/translations";

// Chip: cada dato clave del hero (etiqueta + valor).
export interface Chip {
  label: string;
  value: string;
}

// Props del componente: todas opcionales (tienen default más abajo).
export interface Props {
  eyebrow?: string;
  title1?: string;
  title2?: string;
  description?: string;
  chips?: Chip[];
}

// useTranslations resuelve el idioma activo y devuelve el diccionario (translations).
const { translations, locale } = await useTranslations(Astro.props, Astro);
// tr(): lee una clave del diccionario; el 2º argumento es el fallback si no existe.
const tr = (key: string, fallback: string = "") => getTranslation(translations, key, fallback);

// Desestructura las props con valores por defecto (traducidos). Si quien usa el
// componente pasa una prop, esa gana; si no, se usa el fallback en el idioma actual.
const {
  eyebrow = tr('insights.hero.eyebrow', 'ESCENARIO PRINCIPAL'),
  title1 = 'Smart',
  title2 = 'Insights',
  description = tr('insights.hero.description', 'Contenido estratégico para líderes que impulsan el rumbo de la industria. Conferencias magistrales y paneles de discusión sobre las fuerzas que redefinen los mercados, la innovación y el futuro de los negocios.'),
  chips = [
    { label: tr('insights.hero.chip1_label', 'FECHAS'), value: tr('insights.hero.chip1_value', '18 – 20 Nov 2026') },
    { label: tr('insights.hero.chip2_label', 'SEDE'), value: tr('insights.hero.chip2_value', 'Expo Guadalajara, Jalisco') },
    { label: tr('insights.hero.chip3_label', 'FORMATO'), value: tr('insights.hero.chip3_value', 'Conferencias magistrales y paneles') },
  ],
} = Astro.props;
---

<!-- Cabecera compartida con selector de escenario (marca "conferencias" activa) -->
<HeaderSwitcher active="conferencias" />

<!-- ── HERO ─────────────────────────────────────────────────────────── -->
<section class="ih-hero">
  <!-- Capas decorativas de fondo (no aportan contenido: aria-hidden) -->
  <div class="ih-dots" aria-hidden="true"></div>
  <div class="ih-glow" aria-hidden="true"></div>

  <div class="ih-inner">
    <!-- Eyebrow: línea roja + texto pequeño en mayúsculas -->
    <div class="ih-eyebrow">
      <span class="ih-eyebrow-line"></span>
      <span class="ih-eyebrow-text">{eyebrow}</span>
    </div>

    <!-- Título en 2 líneas: "Smart" arriba, "Insights" abajo -->
    <h1 class="ih-title">
      <span class="ih-title-a">{title1}</span><br />
      <span class="ih-title-b">{title2}</span>
    </h1>

    <p class="ih-description">{description}</p>

    <!-- Chips de datos clave: se generan recorriendo el array `chips` -->
    <div class="ih-chips">
      {chips.map((chip) => (
        <div class="ih-chip">
          <span class="ih-chip-label">{chip.label}</span>
          <span class="ih-chip-value">{chip.value}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── HERO: contenedor ─────────────────────────────────────────────── */
  .ih-hero {
    position: relative;
    background: #000;
    overflow: hidden;
    border-bottom: 1px solid #161616;
    font-family: 'Archivo', Helvetica, Arial, sans-serif;
    color: #fff;
  }

  /* Textura de puntos repetida sobre el fondo. */
  .ih-dots {
    position: absolute;
    inset: 0;
    background-image: repeating-radial-gradient(circle at 78% 42%, #161616 0 1px, transparent 1px 26px);
    opacity: 0.9;
  }

  /* Resplandor rojo difuso en la esquina superior derecha. */
  .ih-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 78% 42%, rgba(226, 16, 26, 0.16), transparent 46%);
  }

  /* ── CONTENEDOR INTERNO ───────────────────────────────────────────── */
  .ih-inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(48px, 9vw, 104px) clamp(16px, 4vw, 40px) clamp(40px, 7vw, 80px);
  }

  /* ── EYEBROW (línea + texto) ──────────────────────────────────────── */
  .ih-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .ih-eyebrow-line {
    width: 30px;
    height: 2px;
    background: #e2101a;
  }

  .ih-eyebrow-text {
    font-size: 12px;
    letter-spacing: 0.3em;
    font-weight: 700;
    color: #fff;
  }

  /* ── TÍTULO ───────────────────────────────────────────────────────── */
  .ih-title {
    margin: 0;
    font-size: clamp(52px, 11vw, 128px);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* Ambas líneas del título llevan el mismo glow blanco en capas. */
  .ih-title-a {
    color: #fff;
    text-shadow:
      0 0 2px  #fff,
      0 0 6px  #fff,
      0 0 12px rgba(255, 255, 255, 0.55),
      0 0 24px rgba(255, 255, 255, 0.35),
      0 0 48px rgba(255, 255, 255, 0.2);
  }

  .ih-title-b {
    color: #fff;
    text-shadow:
      0 0 2px  #fff,
      0 0 6px  #fff,
      0 0 12px rgba(255, 255, 255, 0.55),
      0 0 24px rgba(255, 255, 255, 0.35),
      0 0 48px rgba(255, 255, 255, 0.2);
  }

  /* ── DESCRIPCIÓN ──────────────────────────────────────────────────── */
  .ih-description {
    margin: 26px 0 0;
    max-width: 640px;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.55;
    color: #b9b9b9;
    text-wrap: pretty;
  }

  /* ── CHIPS (datos clave) ──────────────────────────────────────────── */
  .ih-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .ih-chip {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 20px;
    background: #0d0d0d;
    border: 1px solid #1e1e1e;
    border-radius: 5px;
    min-width: 150px;
  }

  .ih-chip-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: #777;
  }

  .ih-chip-value {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
  }
</style>