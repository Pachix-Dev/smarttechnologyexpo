---
import { useTranslations, getTranslation } from "../../utils/translations";
import CountdownReact from "./Countdown.jsx";

const { locale, translations } = await useTranslations(Astro.props, Astro);
const tr = (key: string, fallback: string = "") => getTranslation(translations, key, fallback);
---

<section class="bg-[#1d1d1b] text-white py-8 overflow-hidden">
    <div
    class="mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-8"
    >

    <!-- TEXTO -->
     <div
        class="text-center md:text-left animate-fade-up animate-duration-1000"
        data-aos="fade-right"
        data-aos-delay="200"
     >
     <p class="text-xl md:text-5xl font-semibold uppercase">
  {locale === "en" ? "SEE YOU AT" : "NOS VEMOS EN"}
</p>

<h2 class="mt-3 text-xl md:text-5xl font-extrabold uppercase">
  SMART TECHNOLOGY EXPO
</h2>

     </div>

     <!-- COUNTDOWN -->

     <div
     class="flex flex-col items-center animate-fade-up animate-duration-1000"
     data-aos="fade-left"
     data-aos-delay="400"
     >

     <p class="text-xl font-bold uppercase mb-5">
  {locale === "en" ? "REMAINING" : "FALTAN"}
</p>

     <div class="flex gap-2 md:gap-7">
        <CountdownReact
            client:load
  daysLabel={locale === "en" ? "DAYS" : "DÍAS"}
  hoursLabel={locale === "en" ? "HOURS" : "HORAS"}
  minutesLabel={locale === "en" ? "MINUTES" : "MINUTOS"}
    />     
    </div>
     </div>

    </div>
</section>

<style>

:global(.time-box) {
    width:145px;
    height: 200px;

    background: #ffffff;

    border-radius:18px;

    display:flex;
    flex-direction:column;

    justify-content:center;
    align-items:center;

    position:relative;

    overflow:hidden;

    color:#ed001b
}

:global(.time-box span) {
    font-size:100px;
    font-weight:900;
    line-height:1;
    z-index:1;
}

:global(.time-box small) {
    margin-top:12px;
    font-size:20px;
    font-weight:800;
    z-index:1;
}

@media(max-width:1024px){

    :global(.time-box){
        width:120px;
        height:170px;
    }

    :global(.time-box span){
        font-size:75px;
    }

}


@media(max-width:768px){

    :global(.time-box){
        width:90px;
        height:130px;
    }

    :global(.time-box span){
        font-size:65px;
    }

    :global(.time-box small){
        font-size:14px;
    }

}

</style>