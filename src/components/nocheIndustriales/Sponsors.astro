---
import { useTranslations, getTranslation } from "../../utils/translations";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const base = locale === "es" ? "" : "/en";
---

<section class="bg-[#0b0b0b] h-auto text-white p-4 sm:p-16">
  <div class="max-w-6xl mx-auto flex flex-col items-center gap-y-4">
    <h3
      class="uppercase font-black text-2xl sm:text-4xl text-center text-[#cca058] pb-6 sm:pb-12"
    >
      {tr("nocheIndustriales.sub_title_05")}
    </h3>
    <div class="flex flex-col justify-center items-center gap-8">
      <!-- PATROCINADORES DIAMANTE -->
      <img
        src="/img/nocheIndustriales/beckoff.webp"
        alt="Beckoff"
        class="w-[120px] sm:w-[220px]"
      />
      <!-- PATROCINADORES PLATINO -->
      <img
        src="/img/nocheIndustriales/mitsubishi.webp"
        alt="Mitsubishi"
        class="w-[120px] sm:w-[180px]"
      />
      <!-- PATROCINADORES ORO -->
      <div class="flex flex-row gap-4 sm:gap-10 justify-center items-center">
        <img
          src="/img/nocheIndustriales/b&r.webp"
          alt="B&R"
          class="w-[50px] sm:w-[100px]"
        />
        <img
          src="/img/nocheIndustriales/nojoxten.webp"
          alt="Nojoxten"
          class="w-[70px] sm:w-[200px]"
        />
        <img
          src="/img/nocheIndustriales/schneider.webp"
          alt="Schneider"
          class="w-[70px] sm:w-[190px]"
        />
      </div>
      <!-- PATROCINADORES PLATA -->
      <div
        class="flex flex-wrap sm:flex-row gap-4 sm:gap-10 justify-center items-center"
      >
        <img
          src="/img/nocheIndustriales/absa_bn.webp"
          alt="Absa"
          class="w-[70px] sm:w-[130px]"
        />
        <img
          src="/img/nocheIndustriales/kuka_bn.webp"
          alt="Kuka"
          class="w-[70px] sm:w-[170px]"
        />
        <img
          src="/img/nocheIndustriales/telcel_empresas.webp"
          alt="Telcel Empresas"
          class="w-[70px] sm:w-[130px]"
        />
        <img
          src="/img/nocheIndustriales/ur_robotics.webp"
          alt="UR Robotics"
          class="w-[70px] sm:w-[140px]"
        />
      </div>
      <!-- PATROCINADORES BRONCE -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-4 sm:gap-10 justify-center items-center">
        <img
          src="/img/nocheIndustriales/euchner_logo.webp"
          alt="Euchner"
          class="w-[100px] sm:w-[150px]"
        />
        <img
          src="/img/nocheIndustriales/paloalto.webp"
          alt="Paloalto"
          class="w-[100px] sm:w-[200px]"
        />
        <img
          src="/img/nocheIndustriales/robustel.webp"
          alt="Robustel"
          class="w-[100px] sm:w-[200px]"
        />
        <img
          src="/img/nocheIndustriales/sap.webp"
          alt="SAP"
          class="w-[100px] sm:w-[110px]"
        />
        <img
          src="/img/nocheIndustriales/smartsol.webp"
          alt="Smartsol"
          class="w-[100px] sm:w-[185px]"
        />
        <img
          src="/img/nocheIndustriales/sensortrol_bn.webp"
          alt="Sensortrol"
          class="w-[100px] sm:w-[180px]"
        />
      </div>
    </div>
  </div>
</section>
