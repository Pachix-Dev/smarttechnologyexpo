---
import { useTranslations, getTranslation } from "../../utils/translations";
import Gallery from "./Gallery.astro";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);

const base = locale === "es" ? "" : "/en";
---

<section class="bg-[#0b0b0b] h-auto text-white p-4 sm:p-16">
  <div>
    <h2
      class="uppercase font-black text-2xl sm:text-4xl text-center text-[#cca058] pb-6 sm:pb-12"
    >
      {tr("nocheIndustriales.sub_title_02")}
    </h2>
    <div class="border-2 border-[#cca058]">
      <h3
        class="uppercase font-light tracking-[.45em] text-2xl sm:text-4xl text-[#cca058] border-b-2 border-[#cca058] py-6 text-center w-full"
      >
        NETWORKING
      </h3>
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-18 m-4 sm:m-10">
        <p
          class="text-xl text-justify"
          set:html={tr("nocheIndustriales.description_02")}
        />
        <img
          src="/img/nocheIndustriales/noche_item_01.webp"
          alt="Noche Industriales 2026"
          class="w-[750px]"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-4 sm:gap-18 m-4 sm:m-10 py-10">
    <img
      src="/img/nocheIndustriales/noche_item_02.webp"
      alt="Noche Industriales 2026"
      class="w-[750px]"
      loading="lazy"
    />
    <div class="flex flex-col justify-start items-start">
      <h3
        class="uppercase font-black text-2xl sm:text-4xl text-white pb-6 sm:pb-12"
      >
        {tr("nocheIndustriales.sub_title_03")}
      </h3>
      <p
        class="text-xl text-justify"
        set:html={tr("nocheIndustriales.description_03")}
      />
      <a
        href={`${base}/premio-itzamna-2026`}
        class="uppercase font-bold text-lg sm:text-xl border-2 p-3 flex items-center gap-2 hover:bg-[#cca058] hover:text-black transition-colors duration-300 mt-10"
      >
        {tr("nocheIndustriales.button")}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 15 15"
          ><path
            fill="currentColor"
            d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"
          ></path></svg
        >
      </a>
    </div>
  </div>

  <div class="border-t-2 border-[#cca058]">
    <h3
      class="uppercase font-normal tracking-[.45em] text-xl sm:text-4xl text-[#cca058] pb-6 sm:pb-12 text-center pt-12"
    >
      {tr("nocheIndustriales.sub_title_04")}
    </h3>
    <p
      class="text-xl text-justify"
      set:html={tr("nocheIndustriales.description_04")}
    />
    <Gallery />
  </div>
</section>

<section class="bg-[#cca058] h-auto text-center">
  <div class="max-w-6xl mx-auto p-4 sm:p-16 flex flex-col items-center gap-y-4">
    <h3 class="uppercase font-black text-xl sm:text-4xl text-white">
      {tr("nocheIndustriales.important_note")}
    </h3>
    <a
      href="https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=NPbrEwntT0iO9-slC7AyJuoXe9rlJXZPmsGakvmyQHhURVlJSzI3WjdTS1VPN1VGTkRIMlQxWkcwQy4u"
      target="_blank"
      rel="noopener noreferrer"
      class="py-2 px-6 bg-white font-bold sm:text-2xl flex items-center gap-4 transform hover:scale-105 transition-transform duration-300"
      >{tr("nocheIndustriales.note_registration")}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-[60px] sm:w-[30px]"
        viewBox="0 0 15 15"
        ><path
          fill="currentColor"
          d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"
        ></path></svg
      >
    </a>
    <span class="text-xl sm:text-2xl italic"
      >{tr("nocheIndustriales.registration_subText")}</span
    >
  </div>
</section>
