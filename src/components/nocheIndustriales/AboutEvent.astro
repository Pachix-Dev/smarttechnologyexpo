---
import { useTranslations, getTranslation } from "../../utils/translations";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);
---

<section class="bg-[#0b0b0b] h-auto">
  <div class="grid grid-cols-1 sm:grid-cols-2 text-white p-4 gap-5">
    <div class="flex flex-col justify-center items-center">
      <h2 class="uppercase font-black text-3xl sm:text-4xl text-center">
        {tr("nocheIndustriales.title")}
      </h2>
    </div>
    <div class="flex flex-col justify-center items-center">
      <img
        src="/img/nocheIndustriales/date_event.webp"
        alt="Noche Industriales Event 2026"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 p-4 gap-10">
    <div
      class="w-full h-full border-2 border-[#cca058] p-4 sm:p-10 flex flex-col justify-center items-center"
    >
      <p
        class="text-justify text-white text-xl"
        set:html={tr("nocheIndustriales.description_01")}
      />
    </div>

    <div
      class="flex flex-col items-center text-white w-full h-full border-2 border-[#cca058] text-xl sm:text-2xl text-center py-5"
    >
      <h4
        class="uppercase font-light tracking-[.45em] text-2xl sm:text-4xl text-[#cca058] border-b-2 border-[#cca058] pb-2 w-full"
      >
        {tr("nocheIndustriales.sub_title_01")}
      </h4>
      <div class="flex flex-col gap-y-4 mt-4">
        <p>
          <span class="font-black">18:30 hrs.</span><br />
          {tr("nocheIndustriales.schedule_text_01")}
        </p>
        <p>
          <span class="font-black">19:00 hrs.</span><br />
          {tr("nocheIndustriales.schedule_text_02")}
        </p>
        <p>
          <span class="font-black">19:45 - 20:15 hrs.</span><br />
          {tr("nocheIndustriales.schedule_text_03")}
        </p>
        <p>
          <span class="font-black">20:15 - 23:00 hrs.</span><br />
          {tr("nocheIndustriales.schedule_text_04")}
        </p>
      </div>
    </div>
  </div>
</section>
