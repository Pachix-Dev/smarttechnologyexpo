---
import { useTranslations, getTranslation } from "../../utils/translations";
import AboutSection from "./AboutSection.astro";
import EmbajadoraWomen from "./EmbajadoraWomen.astro";
import HeroWomenPage from "./HeroWomenPage.astro";
import KeyNoteSpeaker from "./KeyNoteSpeaker.astro";
import SectionPricing from "./SectionPricing.astro";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);
---

<section class="w-full">
  <header>
    <HeroWomenPage />
  </header>
    <section>
      <AboutSection />
      <KeyNoteSpeaker />
      <EmbajadoraWomen />
      <SectionPricing />
    </section>
</section>
