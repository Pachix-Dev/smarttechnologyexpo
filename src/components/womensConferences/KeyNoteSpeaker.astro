---
import { useTranslations, getTranslation } from "../../utils/translations";
// ✨ Una sola línea para cargar traducciones!
const { locale, translations } = await useTranslations(Astro.props, Astro);
// 🎯 Helper para traducciones más elegante
const tr = (key: string, fallback: string = "") =>
  getTranslation(translations, key, fallback);
---

<section class="border-y-2 sm:border-y-4 border-[#db0d5c]">
  <div
    class="grid grid-cols-1 sm:grid-cols-2 max-w-7xl mx-auto gap-4 py-2 sm:py-8"
    data-aos="fade-up"
    data-aos-duration="700"
  >
    <div class="p-2">
      <h2
        class="text-4xl sm:text-7xl font-black text-center sm:text-start"
        data-aos="fade-right"
        data-aos-duration="800"
        data-aos-delay="100"
      >
        <span class="text-[#db0d5c]">KEYNOTE</span> SPEAKER
      </h2>
      <div
        class="mt-8"
        data-aos="fade-up"
        data-aos-duration="800"
        data-aos-delay="220"
      >
        <p class="uppercase text-2xl sm:text-4xl font-bold text-[#db0d5c]">
          {locale === "es" ? "Conduciendo el cambio:" : "Driving Change:"}
        </p>
        <p class="text-base text-justify sm:text-2xl">
          {
            locale === "es"
              ? "Mi trayectoria de liderazgo en ingeniería, de la industria aeroespacial al automovilismo"
              : "My leadership journey in engineering, from the aerospace industry to motorsports"
          }
        </p>
      </div>
      <hr class="my-4 border-gray-600" />
      <div
        data-aos="fade-up"
        data-aos-duration="800"
        data-aos-delay="340"
      >
        <h2 class="text-2xl sm:text-4xl font-extrabold mt-4 text-[#db0d5c]">
          SILVIA KARLSSON
        </h2>
        <span class="italic text-base sm: sm:text-2xl"
          >Aerodynamics Manager - CFD Methods | General Motors – Motorsports |
          Board of Directors Member | Society of Women Engineers
        </span>
      </div>
    </div>
    <div
      data-aos="zoom-in-left"
      data-aos-duration="900"
      data-aos-delay="180"
    >
      <img
        src="/img/silvia_karlsson.webp"
        class="w-[200px] sm:w-[450px] rounded-full mx-auto"
        alt="Silvia Karlsson - Smart Technology Expo 2026"
      />
    </div>
  </div>
</section>
