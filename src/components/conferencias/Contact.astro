---
// ============================================================================
//  COMPONENTE CONTACT — Sección Conferencias
//  Autor: Donovan Oswaldo Villalba Hernandez
//
//  Bloque de contacto de la sección Conferencias. Presenta a la persona
//  responsable del programa para resolver dudas o aclaraciones.
//
//  Estructura visual (de fondo a frente):
//    - Fondo negro con patrón de puntos (radial-gradient repetido).
//    - Encabezado centrado: título con efecto glow + subtítulo introductorio.
//    - Tarjeta glassmorphism (blur) en grid de 2 columnas:
//        · Columna IZQUIERDA: foto circular con anillo y sombra.
//        · Columna DERECHA: nombre, puesto y botón-correo (pill).
//    - En móvil la tarjeta colapsa a 1 columna y todo se centra.
//
//  i18n: todos los textos salen de los locales vía tr('clave', 'fallback').
//        Si la clave no existe en el idioma actual, se usa el texto de respaldo.
//        El href del correo arma el mailto: con la misma clave para no duplicar.
// ============================================================================
import { useTranslations, getTranslation } from '../../utils/translations'

export interface Props {
  locale?: string
}

// useTranslations resuelve el idioma activo a partir de las props y del contexto
// de Astro, y devuelve el diccionario de traducciones (translations).
const { locale, translations } = await useTranslations(Astro.props, Astro)

// tr(): atajo para leer una clave del diccionario. El segundo argumento es el
// texto que se muestra si la clave no existe (fallback).
const tr = (key: string, fallback: string = '') =>
  getTranslation(translations, key, fallback)
---

<!-- ── SECCIÓN CONTACTO ─────────────────────────────────────────────── -->
<section class="ct-section">

  <!-- data-aos: animación de entrada (fade-up) al hacer scroll -->
  <div class="ct-inner" data-aos="fade-up" data-aos-duration="800">

    <!-- Encabezado: título + subtítulo introductorio -->
    <div class="ct-header">
      <h2 class="ct-title">{tr('conferencias.contact.title', 'Dudas o comentarios')}</h2>
      <p class="ct-subtitle">{tr('conferencias.contact.subtitle', 'Para cualquier duda o aclaración, favor de contactar a')}</p>
    </div>

    <!-- Tarjeta de la persona de contacto -->
    <div class="ct-card">
      <!-- Foto circular -->
      <div class="ct-photo-wrap">
        <img
          src="/img/conferencias/daniela_hernandez.webp"
          alt="Daniela Hernández"
          class="ct-photo"
        />
      </div>
      <!-- Datos: nombre, puesto y correo. El href arma el mailto: con la misma
           clave del correo para no duplicar el valor. -->
      <div class="ct-info">
        <p class="ct-name">{tr('conferencias.contact.name', 'Daniela Hernández')}</p>
        <p class="ct-role">{tr('conferencias.contact.role', 'Fringe Programs')}</p>
        <a href={`mailto:${tr('conferencias.contact.email', 'daniela.hernandez@igeco.mx')}`} class="ct-email">
          {tr('conferencias.contact.email', 'daniela.hernandez@igeco.mx')}
        </a>
      </div>
    </div>

  </div>
</section>

<style>

  /* ── SECCIÓN: contenedor de fondo ─────────────────────────────────── */
  /* Fondo negro con patrón de puntos (radial-gradient repetido). */
  .ct-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #000000;
    background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1px, transparent 1px);
    background-size: 18px 18px;
    padding: 5rem 2rem;
    box-sizing: border-box;
    border-top: 0px solid rgba(255, 255, 255, 0.845);
  }

  /* ── CONTENEDOR INTERNO ───────────────────────────────────────────── */
  /* Centra el contenido y lo limita a 800px de ancho. */
  .ct-inner {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  /* ── ENCABEZADO ───────────────────────────────────────────────────── */
  .ct-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Título con efecto glow (text-shadow en capas). */
  .ct-title {
    font-family: "Montserrat", sans-serif;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    margin: 0;
    text-shadow:
      0 0 10px rgba(255,255,255,0.9),
      0 0 25px rgba(255,255,255,0.5),
      0 0 50px rgba(255,255,255,0.2);
  }

  .ct-subtitle {
    font-family: "Montserrat", sans-serif;
    font-size: 1rem;
    font-weight: 300;
    color: rgba(255,255,255,0.6);
    margin: 0;
  }

  /* ── TARJETA ──────────────────────────────────────────────────────── */
  /* Card transparente blanca — glassmorphism (backdrop-filter: blur).
     Grid de 2 columnas: foto | información. */
  .ct-card {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 2.5rem;
    border-radius: 16px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 2.5rem 3rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* ── FOTO ─────────────────────────────────────────────────────────── */
  .ct-photo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Imagen circular con anillo y sombra. */
  .ct-photo {
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    display: block;
    background: #fff;
    box-shadow:
      0 0 0 3px rgba(255,255,255,0.15),
      0 8px 24px rgba(0,0,0,0.3);
  }

  /* ── INFORMACIÓN (nombre / puesto / correo) ───────────────────────── */
  .ct-info {
    display: flex;
    flex-direction: column;
    text-align: left;
    gap: 0.2rem;
  }

  .ct-name {
    font-family: "Montserrat", sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    line-height: 1.2;
  }

  .ct-role {
    font-family: "Montserrat", sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255,255,255,0.65);
    margin: 0;
  }

  /* Botón-correo: pill blanca con texto oscuro. */
  .ct-email {
    display: inline-flex;
    align-items: center;
    margin-top: 1rem;
    border-radius: 8px;
    background: #fff;
    padding: 0.55rem 1.25rem;
    font-family: "Montserrat", sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
    transition: background 0.2s;
    align-self: flex-start;
  }

  .ct-email:hover { background: rgba(255,255,255,0.88); }

  /* ── TABLET ───────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .ct-section { padding: 4rem 2rem; }
    .ct-photo   { width: 10rem; height: 10rem; }
    .ct-name    { font-size: 1.4rem; }
    .ct-role    { font-size: 1rem; }
  }

  /* ── MOBILE ───────────────────────────────────────────────────── */
  /* La tarjeta pasa a 1 columna y todo se centra. */
  @media (max-width: 640px) {
    .ct-section { padding: 3rem 1.25rem; }

    .ct-card {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 1.5rem;
      padding: 2rem 1.5rem;
      border-radius: 12px;
    }

    .ct-info    { align-items: center; text-align: center; }
    .ct-email   { align-self: center; }
    .ct-photo   { width: 9rem; height: 9rem; }
    .ct-title   { font-size: clamp(1.5rem, 6vw, 2rem); }
    .ct-name    { font-size: 1.25rem; }
    .ct-role    { font-size: 0.95rem; }
  }

  /* ── MOBILE PEQUEÑO ───────────────────────────────────────────── */
  @media (max-width: 480px) {
    .ct-card  { padding: 1.5rem 1rem; }
    .ct-photo { width: 7.5rem; height: 7.5rem; }
    .ct-name  { font-size: 1.1rem; }
    .ct-email { font-size: 0.78rem; }
  }
</style>