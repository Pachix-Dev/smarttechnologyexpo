---

<section
  aria-labelledby="itzamna-participantes-title"
  class="bg-slate-50 px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20"
>
  <div class="mx-auto w-full max-w-[1440px]">
    <header class="mx-auto max-w-3xl text-center">
      <h2
        id="itzamna-participantes-title"
        class="text-balance text-2xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-3xl lg:text-4xl"
      >
        {
          isEnglish
            ? "Meet the participants and their projects"
            : "Conoce a los participantes y sus proyectos"
        }
      </h2>
    </header>

    <div class="mt-8 grid grid-cols-1 gap-5 sm:mt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-8 2xl:grid-cols-4">
      {
        participantesItzamna.map((participante, index) => {
          const projectTitle = isEnglish
            ? participante.proyectoName.en
            : participante.proyectoName.es;
          const description = (
            isEnglish ? participante.description?.en : participante.description?.es
          )?.trim() ?? "";
          
          const titleId = `itzamna-proyecto-${index + 1}`;

          return (
            <article
              aria-labelledby={titleId}
              class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
            >
              <div class="relative aspect-video w-full shrink-0 overflow-hidden bg-slate-900">
                {participante.src ? (
                  <iframe
                    class="absolute inset-0 h-full w-full border-0"
                    width="560"
                    height="315"
                    src={participante.src}
                    title={`${projectTitle} — ${participante.company}`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  />
                ) : (
                  <p class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm font-medium text-slate-300">
                    {isEnglish ? "Video coming soon" : "Video próximamente"}
                  </p>
                )}
              </div>

              <div class="flex flex-1 flex-col gap-2 p-4 sm:p-5">
                <p class="text-sm font-semibold leading-relaxed text-[#2a4b9b] [overflow-wrap:anywhere] uppercase">
                  {participante.company}
                </p>
                <h3
                  id={titleId}
                  class="text-base font-bold leading-snug text-slate-900 [overflow-wrap:anywhere] sm:text-sm"
                >
                  {projectTitle}
                </h3>
                {description && (
                  <p class="text-base font-bold leading-snug text-slate-900 [overflow-wrap:anywhere] sm:text-sm">
                    {description}
                  </p>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
